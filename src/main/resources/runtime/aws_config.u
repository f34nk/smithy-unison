-- AWS Configuration Runtime Module
-- Shared configuration types used by all generated AWS service clients
--
-- This module provides:
-- - Newtype wrappers for type safety (Region, Service, HostName, Port)
-- - Shared Credentials type
-- - Shared Config type with URI builders
-- - Convenience functions for common configurations

-- =============================================================================
-- Newtype Wrappers for Type Safety
-- =============================================================================

{{
A DNS hostname (e.g., "amazonaws.com", "localhost").
}}
type aws.config.HostName = aws.config.HostName Text

{{
Extract the text value from a HostName.
}}
aws.config.HostName.toText : aws.config.HostName -> Text
aws.config.HostName.toText = cases aws.config.HostName t -> t

{{
A TCP port number.
}}
type aws.config.Port = aws.config.Port Nat

{{
Extract the numeric value from a Port.
}}
aws.config.Port.toNat : aws.config.Port -> Nat
aws.config.Port.toNat = cases aws.config.Port n -> n

-- =============================================================================
-- Region
-- =============================================================================

{{
An AWS region identifier (e.g., "us-east-1", "eu-west-1").

Using a newtype instead of plain Text prevents accidentally passing
a service name where a region is expected.
}}
type aws.config.Region = aws.config.Region Text

{{
Create a Region from a Text value.

Example: Region.fromText "us-east-1"
}}
aws.config.Region.fromText : Text -> aws.config.Region
aws.config.Region.fromText = aws.config.Region

{{
Get the name of a Region as Text.

Example: Region.name Region.usEast1 -- returns "us-east-1"
}}
aws.config.Region.name : aws.config.Region -> Text
aws.config.Region.name = cases aws.config.Region t -> t

-- Common US regions
aws.config.Region.usEast1 : aws.config.Region
aws.config.Region.usEast1 = aws.config.Region "us-east-1"

aws.config.Region.usEast2 : aws.config.Region
aws.config.Region.usEast2 = aws.config.Region "us-east-2"

aws.config.Region.usWest1 : aws.config.Region
aws.config.Region.usWest1 = aws.config.Region "us-west-1"

aws.config.Region.usWest2 : aws.config.Region
aws.config.Region.usWest2 = aws.config.Region "us-west-2"

-- Common EU regions
aws.config.Region.euWest1 : aws.config.Region
aws.config.Region.euWest1 = aws.config.Region "eu-west-1"

aws.config.Region.euWest2 : aws.config.Region
aws.config.Region.euWest2 = aws.config.Region "eu-west-2"

aws.config.Region.euCentral1 : aws.config.Region
aws.config.Region.euCentral1 = aws.config.Region "eu-central-1"

-- Asia Pacific regions
aws.config.Region.apNortheast1 : aws.config.Region
aws.config.Region.apNortheast1 = aws.config.Region "ap-northeast-1"

aws.config.Region.apSoutheast1 : aws.config.Region
aws.config.Region.apSoutheast1 = aws.config.Region "ap-southeast-1"

aws.config.Region.apSoutheast2 : aws.config.Region
aws.config.Region.apSoutheast2 = aws.config.Region "ap-southeast-2"

{{
Load region from environment variables.

Checks AWS_REGION first, then AWS_DEFAULT_REGION.
Returns None if neither is set.

Example:
  match !Region.fromEnv with
    Some r -> ... use region ...
    None -> ... use default ...
}}
aws.config.Region.fromEnv : '{IO} Optional aws.config.Region
aws.config.Region.fromEnv _ =
  r = IO.getEnv "AWS_REGION"
  dr = IO.getEnv "AWS_DEFAULT_REGION"
  regionText = if Text.isEmpty r then dr else r
  if Text.isEmpty regionText then None else Some (aws.config.Region regionText)

-- =============================================================================
-- Service
-- =============================================================================

{{
An AWS service name (e.g., "s3", "kinesis", "lambda").

Using a newtype instead of plain Text prevents accidentally passing
a region where a service name is expected.
}}
type aws.config.Service = aws.config.Service Text

{{
Get the name of a Service as Text.
}}
aws.config.Service.name : aws.config.Service -> Text
aws.config.Service.name = cases aws.config.Service t -> t

{{
Create a Service from a Text value.
}}
aws.config.Service.fromText : Text -> aws.config.Service
aws.config.Service.fromText = aws.config.Service

-- =============================================================================
-- Credentials
-- =============================================================================

{{
AWS credentials for authenticating requests.

Contains the access key ID, secret access key, and optional session token
for temporary credentials (e.g., from STS AssumeRole).
}}
type aws.config.Credentials = {
  accessKeyId : Text,
  secretAccessKey : Text,
  sessionToken : Optional Text
}

{{
Create anonymous credentials (empty strings).

Use for public endpoints that don't require authentication.
}}
aws.config.Credentials.anonymous : aws.config.Credentials
aws.config.Credentials.anonymous = aws.config.Credentials.Credentials "" "" None

{{
Create credentials with just access key and secret key.

Example: basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
}}
aws.config.basicCredentials : Text -> Text -> aws.config.Credentials
aws.config.basicCredentials accessKeyId secretAccessKey =
  aws.config.Credentials.Credentials accessKeyId secretAccessKey None

{{
Create credentials with a session token (for temporary credentials).

Example: temporaryCredentials "AKIAIOSFODNN7EXAMPLE" "secret" "token123"
}}
aws.config.temporaryCredentials : Text -> Text -> Text -> aws.config.Credentials
aws.config.temporaryCredentials accessKeyId secretAccessKey sessionToken =
  aws.config.Credentials.Credentials accessKeyId secretAccessKey (Some sessionToken)

{{
Check if credentials have a session token (are temporary credentials).
}}
aws.config.hasSessionToken : aws.config.Credentials -> Boolean
aws.config.hasSessionToken creds =
  match aws.config.Credentials.sessionToken creds with
    Some _ -> true
    None -> false

-- =============================================================================
-- Config - Shared Configuration Type
-- =============================================================================

{{
Shared configuration for AWS service clients.

This type is used by all generated AWS clients. It contains:
- hostName: The base hostname (e.g., "amazonaws.com")
- port: Optional port override
- region: AWS region
- service: AWS service name
- isHttps: Whether to use HTTPS
- credentials: AWS credentials
- mkServiceUri: Function to build the service URI

Using newtypes for region and service prevents common mistakes like
passing arguments in the wrong order.
}}
type aws.config.Config = {
  hostName : aws.config.HostName,
  port : Optional aws.config.Port,
  region : aws.config.Region,
  service : aws.config.Service,
  isHttps : Boolean,
  credentials : aws.config.Credentials,
  mkServiceUri : Boolean -> aws.config.HostName -> Optional aws.config.Port -> aws.config.Region -> aws.config.Service -> Text
}

-- =============================================================================
-- URI Builders
-- =============================================================================

{{
Build a standard AWS service URI.

Format: https://{service}.{region}.amazonaws.com/

Example: awsServiceUri produces "https://kinesis.us-east-1.amazonaws.com/"
}}
aws.config.Config.awsServiceUri : Boolean -> aws.config.HostName -> Optional aws.config.Port -> aws.config.Region -> aws.config.Service -> Text
aws.config.Config.awsServiceUri isHttps host port region service =
  use Text ++
  scheme = if isHttps then "https" else "http"
  serviceName = aws.config.Service.name service
  regionName = aws.config.Region.name region
  hostText = aws.config.HostName.toText host
  
  -- Build: {service}.{region}.{host}
  fullHost = serviceName ++ "." ++ regionName ++ "." ++ hostText
  
  portSuffix = match port with
    Some p -> ":" ++ Nat.toText (aws.config.Port.toNat p)
    None -> ""
  
  scheme ++ "://" ++ fullHost ++ portSuffix ++ "/"

{{
Build a custom endpoint URI (ignores service/region in host).

Format: {scheme}://{host}:{port}/
}}
aws.config.Config.customEndpointUri : Boolean -> aws.config.HostName -> Optional aws.config.Port -> aws.config.Region -> aws.config.Service -> Text
aws.config.Config.customEndpointUri isHttps host port region service =
  use Text ++
  -- Ignore region and service for custom endpoints
  _ = region
  _ = service
  scheme = if isHttps then "https" else "http"
  hostText = aws.config.HostName.toText host
  
  portSuffix = match port with
    Some p -> ":" ++ Nat.toText (aws.config.Port.toNat p)
    None -> ""
  
  scheme ++ "://" ++ hostText ++ portSuffix ++ "/"

{{
Build the complete URI from a Config.
}}
aws.config.Config.makeUri : aws.config.Config -> Text
aws.config.Config.makeUri config =
  (aws.config.Config.mkServiceUri config) 
    (aws.config.Config.isHttps config) 
    (aws.config.Config.hostName config) 
    (aws.config.Config.port config) 
    (aws.config.Config.region config) 
    (aws.config.Config.service config)

{{
Get the scheme (http or https) from a Config.
}}
aws.config.Config.scheme : aws.config.Config -> Text
aws.config.Config.scheme config = 
  if aws.config.Config.isHttps config then "https" else "http"

-- =============================================================================
-- Config Constructors
-- =============================================================================

{{
Create a Config for production AWS endpoints.

Uses HTTPS and standard AWS service URI format:
https://{service}.{region}.amazonaws.com/

Example:
  config = Config.default Region.usEast1 (Service "kinesis") creds
}}
aws.config.Config.default : aws.config.Region -> aws.config.Service -> aws.config.Credentials -> aws.config.Config
aws.config.Config.default region service creds =
  aws.config.Config.Config 
    (aws.config.HostName "amazonaws.com")
    None
    region
    service
    true  -- HTTPS
    creds
    aws.config.Config.awsServiceUri

{{
Create a Config for a custom endpoint (e.g., MinIO, or other S3-compatible storage).

Parses the endpoint string to extract scheme, host, and port.

Example:
  config = Config.withEndpoint "http://localhost:9000" Region.usEast1 (Service "s3") creds
}}
aws.config.Config.withEndpoint : Text -> aws.config.Region -> aws.config.Service -> aws.config.Credentials -> aws.config.Config
aws.config.Config.withEndpoint endpoint region service creds =
  -- Simple endpoint parsing
  isHttps = Text.startsWith "https://" endpoint
  
  -- Strip scheme
  withoutScheme = 
    if Text.startsWith "https://" endpoint 
      then Text.drop 8 endpoint
    else if Text.startsWith "http://" endpoint 
      then Text.drop 7 endpoint
    else endpoint
  
  -- Strip trailing slash and path
  hostPort = 
    match Text.indexOf "/" withoutScheme with
      Some idx -> Text.take idx withoutScheme
      None -> withoutScheme
  
  -- Split host and port
  (host, port) = 
    match Text.indexOf ":" hostPort with
      Some idx -> 
        h = Text.take idx hostPort
        p = Text.drop (idx Nat.+ 1) hostPort
        pNat = Optional.flatMap Nat.fromText (Some p)
        (h, Optional.map aws.config.Port pNat)
      None -> (hostPort, None)
  
  aws.config.Config.Config
    (aws.config.HostName host)
    port
    region
    service
    isHttps
    creds
    aws.config.Config.customEndpointUri

-- =============================================================================
-- Backward Compatibility Helpers
-- =============================================================================

-- Plain text region constants (for backward compatibility)
aws.config.usEast1 : Text
aws.config.usEast1 = "us-east-1"

aws.config.usEast2 : Text
aws.config.usEast2 = "us-east-2"

aws.config.usWest1 : Text
aws.config.usWest1 = "us-west-1"

aws.config.usWest2 : Text
aws.config.usWest2 = "us-west-2"

aws.config.euWest1 : Text
aws.config.euWest1 = "eu-west-1"

aws.config.euWest2 : Text
aws.config.euWest2 = "eu-west-2"

aws.config.euCentral1 : Text
aws.config.euCentral1 = "eu-central-1"

aws.config.apNortheast1 : Text
aws.config.apNortheast1 = "ap-northeast-1"

aws.config.apSoutheast1 : Text
aws.config.apSoutheast1 = "ap-southeast-1"

aws.config.apSoutheast2 : Text
aws.config.apSoutheast2 = "ap-southeast-2"

{{
Check if a region string is a valid AWS region format.

Valid format: two letters, hyphen, word, hyphen, digit(s)
Example: "us-east-1", "eu-west-2", "ap-northeast-1"
}}
aws.config.isValidRegion : Text -> Boolean
aws.config.isValidRegion region =
  let
    hasCorrectFormat = Text.contains "-" region
    notEmpty = not (Text.isEmpty region)
    notTooLong = Nat.lteq (Text.size region) 20
    hasCorrectFormat && notEmpty && notTooLong

-- Default values
aws.config.defaultTimeout : Nat
aws.config.defaultTimeout = 30000

aws.config.defaultMaxRetries : Nat
aws.config.defaultMaxRetries = 3

aws.config.defaultRegion : Text
aws.config.defaultRegion = "us-east-1"

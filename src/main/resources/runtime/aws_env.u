-- AWS Environment Ability Runtime Module
-- Provides ability-based signing and region/credential management
--
-- This module provides:
-- - AWSEnv ability for request signing and region access
-- - Handlers for explicit config and environment variables
-- - Convenience functions for running AWS operations

-- =============================================================================
-- AWSEnv Ability
-- =============================================================================

{{
AWSEnv ability for AWS request signing and region access.

Operations requiring AWS credentials should declare `{AWSEnv}` instead of
threading config parameters manually.

Example:
  result = AWSEnv.provide.fromEnv do
    signedRequest = AWSEnv.sign "lambda" baseRequest
    region = AWSEnv.region
    ...
}}
ability AWSEnv where
  -- Get the configured AWS region (e.g., "us-east-1").
  region : {AWSEnv} Text

  -- Get the optional custom endpoint (e.g., "http://localhost:4566" for LocalStack).
  -- Returns None for standard AWS endpoints.
  endpoint : {AWSEnv} Optional Text

  -- Sign an HTTP request for the specified service.
  -- Adds x-amz-date, x-amz-content-sha256, Authorization, and optional
  -- x-amz-security-token headers.
  sign : Text -> Http.Request ->{AWSEnv} Http.Request

-- =============================================================================
-- Handler Implementation
-- =============================================================================

{{
Create an AWSEnv handler from explicit region, credentials, and optional endpoint.

Example:
  handler = AWSEnv.handler "us-east-1" (aws.config.basicCredentials "AKIA..." "secret...") None
  handle myOperation() with handler
  
  -- For LocalStack:
  handler = AWSEnv.handler "us-east-1" (aws.config.basicCredentials "test" "test") (Some "http://localhost:4566")
  handle myOperation() with handler
}}
AWSEnv.handler : Text -> aws.config.Credentials -> Optional Text -> builtin.Request {AWSEnv} a ->{IO, Exception} a
AWSEnv.handler regionName creds endpointUrl = cases
  { a } -> a
  { AWSEnv.region -> k } -> handle k regionName with AWSEnv.handler regionName creds endpointUrl
  { AWSEnv.endpoint -> k } -> handle k endpointUrl with AWSEnv.handler regionName creds endpointUrl
  { AWSEnv.sign service httpRequest -> k } ->
    signedRequest = aws.env.signRequest regionName service creds httpRequest
    handle k signedRequest with AWSEnv.handler regionName creds endpointUrl

{{
Create an AWSEnv handler from environment variables.

Uses AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and optionally
AWS_SESSION_TOKEN and AWS_ENDPOINT.

Example:
  handle myOperation() with !AWSEnv.handler.fromEnv
}}
AWSEnv.handler.fromEnv : '{IO, Exception} (builtin.Request {AWSEnv} a ->{IO, Exception} a)
AWSEnv.handler.fromEnv = do
  regionName = getEnv "AWS_REGION"
  creds = match !aws.credentials.fromEnvironment with
    Some c -> c
    None -> Exception.raise (Generic.failure "Missing AWS credentials in environment" ())
  endpointEnv = getEnv "AWS_ENDPOINT"
  endpointUrl = if Text.isEmpty endpointEnv then None else Some endpointEnv
  AWSEnv.handler regionName creds endpointUrl

{{
Convenience wrapper that handles an AWSEnv computation using environment variables.

Example:
  result = AWSEnv.provide.fromEnv do
    ... operations using AWSEnv ...
}}
AWSEnv.provide.fromEnv : '{g, AWSEnv} r ->{g, IO, Exception} r
AWSEnv.provide.fromEnv f = handle f() with !AWSEnv.handler.fromEnv

-- =============================================================================
-- Internal: Request Signing
-- =============================================================================

{{
Sign an HTTP request with SigV4.

Internal helper used by the AWSEnv handler.
}}
aws.env.signRequest : Text -> Text -> aws.config.Credentials -> Http.Request ->{IO, Exception} Http.Request
aws.env.signRequest regionName serviceName creds request =
  -- Build signing credentials from config credentials
  accessKey = aws.config.Credentials.accessKeyId creds
  secretKey = aws.config.Credentials.secretAccessKey creds
  sessionToken = aws.config.Credentials.sessionToken creds
  signingCreds = aws.sigv4.Credentials.Credentials accessKey secretKey sessionToken
  signingConfig = aws.sigv4.SigningConfig.SigningConfig regionName serviceName signingCreds
  -- Extract request parts
  method = Http.Request.method request
  url = Http.Request.url request
  path = aws.http.extractPath url
  queryString = aws.env.extractQueryString url
  headers = Http.Request.headers request
  hostHeader = ("Host", aws.http.extractHost url)
  hasHost = List.any (h -> match h with (name, _) -> Text.eq (Text.toLowercase name) "host") headers
  headersWithHost = if hasHost then headers else hostHeader List.+: headers
  body = Http.Request.body request
  -- Sign and merge headers
  signingHeaders = !(aws.sigv4.signRequest signingConfig method path queryString headersWithHost body)
  -- Add signing headers to request
  newHeaders = headersWithHost List.++ signingHeaders
  Http.Request.Request method url newHeaders body

{{
Extract query string from URL (everything after ?).
}}
aws.env.extractQueryString : Text -> Text
aws.env.extractQueryString url =
  match Text.indexOf "?" url with
    Some idx -> Text.drop (idx Nat.+ 1) url
    None -> ""

-- AWS JSON Bridge Module
-- Bridge between Unison JSON types and HTTP request/response bodies
-- Provides integration between aws_json.u and aws_http.u

namespace aws.json.bridge

use aws.json
use Bytes

-- =============================================================================
-- Request Serialization
-- =============================================================================

{{
  Serialize a JsonValue to bytes for HTTP request body.
  
  Converts JSON to compact text and encodes as UTF-8 bytes.
  
  Example:
  @typechecked ```
  serializeJsonRequest (JsonObject [("name", JsonString "Alice")])
  ```
}}
serializeJsonRequest : JsonValue -> Bytes
serializeJsonRequest value =
  text = toJson value
  toUtf8 text

{{
  Serialize a JsonValue to text for HTTP request body.
  
  Returns compact JSON text without pretty-printing.
  Use this when you need the text representation directly.
  
  Example:
  @typechecked ```
  jsonToRequestBody (JsonObject [("TableName", JsonString "users")])
  ```
}}
jsonToRequestBody : JsonValue -> Text
jsonToRequestBody value = toJson value

-- =============================================================================
-- Response Deserialization
-- =============================================================================

{{
  Deserialize HTTP response body bytes to JsonValue.
  
  Decodes UTF-8 bytes to text and parses as JSON.
  Raises an exception if the bytes are not valid UTF-8 or valid JSON.
}}
deserializeJsonResponse : Bytes -> '{Exception} JsonValue
deserializeJsonResponse bytes = 'let
  text = Text.fromUtf8 bytes
  parseJson text ()

{{
  Parse HTTP response body text to JsonValue.
  
  Raises an exception if the text is not valid JSON.
}}
responseBodyToJson : Text -> '{Exception} JsonValue
responseBodyToJson text = parseJson text

-- =============================================================================
-- AWS JSON Error Parsing
-- =============================================================================

structural type JsonError = { errorType : Text, errorMessage : Text }

{{
  Parse AWS JSON error response.
  
  AWS JSON services like DynamoDB return errors with __type and message fields.
  The __type field can be in full format with namespace or short format.
  
  Returns a JsonError record with errorType and errorMessage fields.
  Returns None if the text is not valid JSON or doesn't match the expected format.
}}
parseJsonError : Text -> Optional JsonError
parseJsonError text =
  match fromJson text with
    Some json ->
      errorType = extractErrorType json
      errorMessage = extractErrorMessage json
      match (errorType, errorMessage) with
        (Some et, Some em) -> Some (JsonError.JsonError et em)
        (Some et, None) -> Some (JsonError.JsonError et "")
        (None, Some em) -> Some (JsonError.JsonError "UnknownError" em)
        (None, None) -> None
    None -> None

{{
  Extract the error type from an AWS JSON error response.
  
  Looks for the `__type` field and extracts the error name.
  Handles both full format ("com.amazon.coral.validate#ValidationException")
  and short format ("ValidationException").
}}
extractErrorType : JsonValue -> Optional Text
extractErrorType json =
  match getFieldAsString "__type" json with
    Some fullType ->
      -- Extract error name from full format: "namespace#ErrorName" -> "ErrorName"
      if Text.contains "#" fullType then
        parts = Text.split ?# fullType
        match List.last parts with
          Some errorName -> Some errorName
          None -> Some fullType
      else
        Some fullType
    None -> None

{{
  Extract the error message from an AWS JSON error response.
  
  Looks for the `message` or `Message` field (AWS services use both conventions).
}}
extractErrorMessage : JsonValue -> Optional Text
extractErrorMessage json =
  match getFieldAsString "message" json with
    Some msg -> Some msg
    None -> getFieldAsString "Message" json

-- =============================================================================
-- Field Extraction Utilities
-- =============================================================================

{{
  Extract a required field from a JSON object and parse it.
  
  This function looks for a field by name in a JSON object, applies a parser function
  to convert it to the desired type, and raises an exception if the field is missing.
  
  Use this for required fields in response parsing.
}}
extractField : Text -> JsonValue -> (JsonValue -> '{Exception} a) -> '{Exception} a
extractField fieldName json parser =
  match getField fieldName json with
    Some fieldValue -> parser fieldValue
    None -> Exception.raise (Generic.failure "Missing required field" fieldName)

{{
  Extract an optional field from a JSON object and parse it (with Exception-based parser).
  
  This function looks for a field by name in a JSON object, applies an Exception-returning
  parser function to convert it to the desired type. Returns None if the field is missing
  or if parsing fails (exception is caught and converted to None).
  
  Use this for optional fields in response parsing with Exception-based parsers.
}}
extractOptionalField : Text -> JsonValue -> (JsonValue -> '{Exception} a) -> Optional a
extractOptionalField fieldName json parser =
  match getField fieldName json with
    Some fieldValue -> 
      match catch do !(parser fieldValue) with
        Right value -> Some value
        Left _ -> None
    None -> None

{{
  Extract an optional field from a JSON object and parse it (legacy Optional-based parser).
  
  This is a generic field extractor that looks for a field by name in a JSON object,
  applies a parser function to convert it to the desired type, and returns None if the
  field doesn't exist or parsing fails.
  
  NOTE: This is the legacy version using Optional-based parsers. 
  Prefer the Exception-based version for new code.
}}
extractOptionalFieldLegacy : Text -> JsonValue -> (JsonValue -> Optional a) -> Optional a
extractOptionalFieldLegacy fieldName json parser =
  match getField fieldName json with
    Some fieldValue -> parser fieldValue
    None -> None

{{
  Expect a string value from a JSON value.
  
  Helper function for extractOptionalField that converts a JsonValue to Text.
  Returns None if the value is not a string.
}}
expectString : JsonValue -> Optional Text
expectString = cases
  JsonString s -> Some s
  _ -> None

{{
  Expect an integer value from a JSON value.
  
  Helper function for extractOptionalField that converts a JsonValue to Int.
  Returns None if the value is not a number or cannot be converted to Int.
}}
expectInt : JsonValue -> Optional Int
expectInt = cases
  JsonNumber n -> Float.toInt n
  _ -> None

{{
  Expect a boolean value from a JSON value.
  
  Helper function for extractOptionalField that converts a JsonValue to Boolean.
  Returns None if the value is not a boolean.
}}
expectBoolean : JsonValue -> Optional Boolean
expectBoolean = cases
  JsonBoolean b -> Some b
  _ -> None

-- =============================================================================
-- Exception-Based Field Parsers (for required fields)
-- =============================================================================

{{
  Parse a JSON value as a string.
  
  Raises an exception if the value is not a string.
  Use with extractField for required string fields.
}}
parseString : JsonValue -> '{Exception} Text
parseString json = 'let
  match json with
    JsonString s -> s
    v -> Exception.raise (Generic.failure "Expected string" v)

{{
  Parse a JSON value as an integer.
  
  Raises an exception if the value is not a number or cannot be converted to Int.
  Use with extractField for required integer fields.
}}
parseInt : JsonValue -> '{Exception} Int
parseInt json = 'let
  match json with
    JsonNumber n -> match Float.toInt n with
      Some i -> i
      None -> Exception.raise (Generic.failure "Number not an integer" n)
    v -> Exception.raise (Generic.failure "Expected number" v)

{{
  Parse a JSON value as a boolean.
  
  Raises an exception if the value is not a boolean.
  Use with extractField for required boolean fields.
}}
parseBoolean : JsonValue -> '{Exception} Boolean
parseBoolean json = 'let
  match json with
    JsonBoolean b -> b
    v -> Exception.raise (Generic.failure "Expected boolean" v)

{{
  Parse a JSON value as a float.
  
  Raises an exception if the value is not a number.
  Use with extractField for required float fields.
}}
parseFloat : JsonValue -> '{Exception} Float
parseFloat json = 'let
  match json with
    JsonNumber f -> f
    v -> Exception.raise (Generic.failure "Expected number" v)

{{
  Parse a JSON value as an array.
  
  Raises an exception if the value is not an array.
  Use with extractField for required array fields.
}}
parseArray : JsonValue -> '{Exception} [JsonValue]
parseArray json = 'let
  match json with
    JsonArray items -> items
    v -> Exception.raise (Generic.failure "Expected array" v)

{{
  Parse a JSON value as an object.
  
  Raises an exception if the value is not an object.
  Use with extractField for required object fields.
}}
parseObject : JsonValue -> '{Exception} [(Text, JsonValue)]
parseObject json = 'let
  match json with
    JsonObject fields -> fields
    v -> Exception.raise (Generic.failure "Expected object" v)

{{
  Parse a JSON value as a blob (base64-encoded bytes).
  
  Raises an exception if the value is not a string or cannot be decoded from base64.
  Use with extractField for required blob fields.
}}
parseBlob : JsonValue -> '{Exception} Bytes
parseBlob json = 'let
  match json with
    JsonString s -> 
      match builtin.Bytes.fromBase64 (toUtf8 s) with
        Right bytes -> bytes
        Left err -> Exception.raise (Generic.failure "Invalid base64 encoding" err)
    v -> Exception.raise (Generic.failure "Expected base64-encoded string for blob" v)

{{
  Map a list of JSON values with an exception-raising deserializer.
  
  This function properly sequences exception-raising deserializations for list elements.
  Use this when deserializing lists where each element needs to be parsed with an exception-raising function.
}}
mapWithException : [a] -> (a -> '{Exception} b) -> '{Exception} [b]
mapWithException items deserializer = 'let
  go = cases
    [] -> []
    h +: t -> 
      head = !(deserializer h)
      tail = go t
      head List.+: tail
  go items

{{
  Map a list of key-value pairs with an exception-raising value deserializer.
  
  This function properly sequences exception-raising deserializations for map values.
  Use this when deserializing maps where values need to be parsed with an exception-raising function.
}}
mapPairsWithException : [(Text, JsonValue)] -> (JsonValue -> '{Exception} a) -> '{Exception} [(Text, a)]
mapPairsWithException pairs valueDeserializer = 'let
  go = cases
    [] -> []
    (k, v) +: t ->
      value = !(valueDeserializer v)
      tail = go t
      (k, value) List.+: tail
  go pairs

-- =============================================================================
-- Convenience Functions
-- =============================================================================

{{
  Parse a DynamoDB Item from JSON response.
  
  DynamoDB returns items as maps where each value is an AttributeValue with a type tag
  (e.g., S for string, N for number). This function extracts the Item field and converts
  each field value from JSON to AttributeValue.
}}
parseItemFromJson : JsonValue -> Optional [(Text, AttributeValue)]
parseItemFromJson json =
  match getFieldAsObject "Item" json with
    Some (JsonObject fields) ->
      toAttr = cases
        (k, v) -> match jsonToAttributeValue v with
          Some attr -> Some (k, attr)
          None -> None
      attrs = List.map toAttr fields
      if List.all Optional.isSome attrs then
        Some (List.map (a -> Optional.getOrElse ("", AttributeValue'NULL true) a) attrs)
      else None
    _ -> None

{{
  Serialize a DynamoDB Item to JSON for requests.
  
  Takes a map of field names to AttributeValues and converts to the JSON format
  expected by DynamoDB operations.
}}
serializeItemToJson : [(Text, AttributeValue)] -> JsonValue
serializeItemToJson item =
  fields = List.map (cases (k, v) -> (k, attributeValueToJson v)) item
  JsonObject fields

{{
  Parse a DynamoDB Key from JSON.
  
  Similar to parseItemFromJson but typically used for parsing the Key field
  in requests/responses.
}}
parseKeyFromJson : JsonValue -> Optional [(Text, AttributeValue)]
parseKeyFromJson json =
  match getFieldAsObject "Key" json with
    Some (JsonObject fields) ->
      toAttr = cases
        (k, v) -> match jsonToAttributeValue v with
          Some attr -> Some (k, attr)
          None -> None
      attrs = List.map toAttr fields
      if List.all Optional.isSome attrs then
        Some (List.map (a -> Optional.getOrElse ("", AttributeValue'NULL true) a) attrs)
      else None
    _ -> None

{{
  Serialize a DynamoDB Key to JSON.
}}
serializeKeyToJson : [(Text, AttributeValue)] -> JsonValue
serializeKeyToJson key = serializeItemToJson key

{{
  Parse a list of DynamoDB Items from JSON response.
  
  Used for operations that return multiple items (Query, Scan, BatchGetItem).
  Extracts the Items field which contains an array of DynamoDB items.
}}
parseItemsFromJson : JsonValue -> Optional [[(Text, AttributeValue)]]
parseItemsFromJson json =
  toAttr = cases
    (k, v) -> match jsonToAttributeValue v with
      Some attr -> Some (k, attr)
      None -> None
  parseItem = cases
    JsonObject fields ->
      attrs = List.map toAttr fields
      if List.all Optional.isSome attrs then
        Some (List.map (a -> Optional.getOrElse ("", AttributeValue'NULL true) a) attrs)
      else None
    _ -> None
  match getFieldAsArray "Items" json with
    Some items ->
      parsedItems = List.map parseItem items
      if List.all Optional.isSome parsedItems then
        Some (List.map (i -> Optional.getOrElse [] i) parsedItems)
      else None
    _ -> None

-- =============================================================================
-- core.Json Helper Functions
-- =============================================================================
-- These functions provide extraction and parsing utilities for core.Json,
-- mirroring the pattern used by aws_xml_bridge.u for XML/Soup.
-- They will be used by updated code generators that emit core.Json-based code.

{{
  Find a text field in a JSON object.
  Returns None if field doesn't exist or isn't a string.
  
  Example:
  @typechecked ```
  json = Json.Object [("name", Json.Text "Alice")]
  aws.json.bridge.coreJsonFindText "name" json == Some "Alice"
  ```
}}
coreJsonFindText : Text -> core.Json -> Optional Text
coreJsonFindText key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Text t) -> Some t
        _ -> None
    _ -> None

{{
  Find an integer field in a JSON object.
  Returns None if field doesn't exist or isn't a number.
}}
coreJsonFindInt : Text -> core.Json -> Optional Int
coreJsonFindInt key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Number numText) -> Int.fromText numText
        _ -> None
    _ -> None

{{
  Find a Nat field in a JSON object.
  Returns None if field doesn't exist or isn't a number.
}}
coreJsonFindNat : Text -> core.Json -> Optional Nat
coreJsonFindNat key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Number numText) -> Nat.fromText numText
        _ -> None
    _ -> None

{{
  Find a Float field in a JSON object.
  Returns None if field doesn't exist or isn't a number.
}}
coreJsonFindFloat : Text -> core.Json -> Optional Float
coreJsonFindFloat key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Number numText) -> Float.fromText numText
        _ -> None
    _ -> None

{{
  Find a boolean field in a JSON object.
  Returns None if field doesn't exist or isn't a boolean.
}}
coreJsonFindBool : Text -> core.Json -> Optional Boolean
coreJsonFindBool key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Boolean b) -> Some b
        _ -> None
    _ -> None

{{
  Find a nested JSON object field.
  Returns None if field doesn't exist.
}}
coreJsonFindObject : Text -> core.Json -> Optional core.Json
coreJsonFindObject key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, obj@(core.Json.Object _)) -> Some obj
        _ -> None
    _ -> None

{{
  Find a JSON array field.
  Returns None if field doesn't exist.
}}
coreJsonFindArray : Text -> core.Json -> Optional [core.Json]
coreJsonFindArray key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Array items) -> Some items
        _ -> None
    _ -> None

{{
  Find an array field and extract all text elements.
  Returns empty list if field doesn't exist or contains non-text elements.
}}
coreJsonFindAllText : Text -> core.Json -> [Text]
coreJsonFindAllText key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Array items) ->
          List.filterMap (cases
            core.Json.Text t -> Some t
            _ -> None) items
        _ -> []
    _ -> []

{{
  Find an array field and extract all integer elements.
}}
coreJsonFindAllInt : Text -> core.Json -> [Int]
coreJsonFindAllInt key json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Array items) ->
          List.filterMap (cases
            core.Json.Number n -> Int.fromText n
            _ -> None) items
        _ -> []
    _ -> []

{{
  Parse a nested structure from JSON.
  Returns None if the field doesn't exist.
}}
coreJsonParseNested : Text -> (core.Json -> a) -> core.Json -> Optional a
coreJsonParseNested key parser json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, nested) -> Some (parser nested)
        _ -> None
    _ -> None

{{
  Parse a list of structures from JSON array field.
  Returns empty list if field doesn't exist.
}}
coreJsonParseList : Text -> (core.Json -> a) -> core.Json -> [a]
coreJsonParseList key parser json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Array items) -> List.map parser items
        _ -> []
    _ -> []

{{
  Parse optional list from JSON array field.
  Returns None if field doesn't exist, Some [a] otherwise.
}}
coreJsonParseOptionalList : Text -> (core.Json -> a) -> core.Json -> Optional [a]
coreJsonParseOptionalList key parser json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Array items) -> Some (List.map parser items)
        _ -> None
    _ -> None

{{
  Parse a map from JSON object field.
  Returns empty list of pairs if field doesn't exist.
}}
coreJsonParseMap : Text -> (core.Json -> a) -> core.Json -> [(Text, a)]
coreJsonParseMap key valueParser json =
  match json with
    core.Json.Object fields ->
      match List.find (cases (k, _) -> k === key) fields with
        Some (_, core.Json.Object mapFields) ->
          List.map (cases (k, v) -> (k, valueParser v)) mapFields
        _ -> []
    _ -> []

{{
  Require a text field, raising Exception if missing.
}}
coreJsonRequireText : Text -> core.Json -> '{Exception} Text
coreJsonRequireText key json = do
  match coreJsonFindText key json with
    Some t -> t
    None -> Exception.raise (Generic.failure ("Required JSON field not found: " Text.++ key) json)

{{
  Require an int field, raising Exception if missing.
}}
coreJsonRequireInt : Text -> core.Json -> '{Exception} Int
coreJsonRequireInt key json = do
  match coreJsonFindInt key json with
    Some i -> i
    None -> Exception.raise (Generic.failure ("Required JSON field not found: " Text.++ key) json)

{{
  Require a Nat field, raising Exception if missing.
}}
coreJsonRequireNat : Text -> core.Json -> '{Exception} Nat
coreJsonRequireNat key json = do
  match coreJsonFindNat key json with
    Some n -> n
    None -> Exception.raise (Generic.failure ("Required JSON field not found: " Text.++ key) json)

{{
  Require a boolean field, raising Exception if missing.
}}
coreJsonRequireBool : Text -> core.Json -> '{Exception} Boolean
coreJsonRequireBool key json = do
  match coreJsonFindBool key json with
    Some b -> b
    None -> Exception.raise (Generic.failure ("Required JSON field not found: " Text.++ key) json)

{{
  Require a nested structure, raising Exception if missing.
}}
coreJsonRequireNested : Text -> (core.Json -> a) -> core.Json -> '{Exception} a
coreJsonRequireNested key parser json = do
  match coreJsonParseNested key parser json with
    Some a -> a
    None -> Exception.raise (Generic.failure ("Required JSON field not found: " Text.++ key) json)

-- =============================================================================
-- core.Json HTTP Bridge Functions
-- =============================================================================

{{
  Serialize a core.Json value to bytes for HTTP request body.
}}
serializeCoreJsonRequest : core.Json -> Bytes
serializeCoreJsonRequest value =
  text = core.Json.toText value
  toUtf8 text

{{
  Serialize a core.Json value to text for HTTP request body.
}}
coreJsonToRequestBody : core.Json -> Text
coreJsonToRequestBody value = core.Json.toText value

{{
  Deserialize HTTP response body bytes to core.Json.
  Raises an Exception if the bytes are not valid UTF-8 or valid JSON.
}}
deserializeCoreJsonResponse : Bytes -> '{Exception} core.Json
deserializeCoreJsonResponse bytes = do
  text = Text.fromUtf8 bytes
  core.Json.fromText text

{{
  Parse HTTP response body text to core.Json.
  Raises an Exception if the text is not valid JSON.
}}
responseBodyToCoreJson : Text -> '{Exception} core.Json
responseBodyToCoreJson text = core.Json.fromText text

-- =============================================================================
-- core.Json Error Parsing
-- =============================================================================

{{
  Extract the error type from an AWS JSON error response (core.Json version).
  
  Looks for the `__type` field and extracts the error name.
  Handles both full format ("com.amazon.coral.validate#ValidationException")
  and short format ("ValidationException").
}}
extractCoreJsonErrorType : core.Json -> Optional Text
extractCoreJsonErrorType json =
  match coreJsonFindText "__type" json with
    Some fullType ->
      if Text.contains "#" fullType then
        parts = Text.split ?# fullType
        match List.last parts with
          Some errorName -> Some errorName
          None -> Some fullType
      else
        Some fullType
    None -> None

{{
  Extract the error message from an AWS JSON error response (core.Json version).
  
  Looks for the `message` or `Message` field (AWS services use both conventions).
}}
extractCoreJsonErrorMessage : core.Json -> Optional Text
extractCoreJsonErrorMessage json =
  match coreJsonFindText "message" json with
    Some msg -> Some msg
    None -> coreJsonFindText "Message" json

{{
  Parse AWS JSON error response from core.Json.
  
  Returns a JsonError record with errorType and errorMessage fields.
  Returns None if the JSON doesn't match the expected error format.
}}
parseCoreJsonError : core.Json -> Optional JsonError
parseCoreJsonError json =
  errorType = extractCoreJsonErrorType json
  errorMessage = extractCoreJsonErrorMessage json
  match (errorType, errorMessage) with
    (Some et, Some em) -> Some (JsonError.JsonError et em)
    (Some et, None) -> Some (JsonError.JsonError et "")
    (None, Some em) -> Some (JsonError.JsonError "UnknownError" em)
    (None, None) -> None

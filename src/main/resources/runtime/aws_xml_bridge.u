-- AWS XML Bridge Module
-- Bridges AWS XML utilities to @unison/xml library
--
-- REQUIRES: @unison/xml library
--   lib.install @unison/xml/releases/1.2.0
--
-- This module provides functions to:
-- 1. Parse XML using Soup (cursor-based navigation)
-- 2. Bridge between our text-based extraction and library types
-- 3. Provide higher-level XML navigation helpers
--
-- Load this module AFTER loading aws_xml.u and installing @unison/xml

-- Helper to convert Throw to Optional without ambiguity
-- Uses Throw.toEither which is unambiguous, then converts to Optional
throwToOptional : '{g, Throw e} a ->{g} Optional a
throwToOptional thunk = 
  match Throw.toEither thunk with
    Left _ -> None
    Right result -> Some result

-- =============================================================================
-- XML Parsing
-- =============================================================================

{{
Parse XML text to a Soup cursor for navigation.

This wraps the @unison/xml library's Soup.parseXML function.
}}
aws.xml.parse : Text -> Soup
aws.xml.parse = Soup.parseXML

{{
Parse XML bytes to a Soup cursor.

Decodes UTF-8 bytes to text, then parses as XML.
Requires Exception ability for UTF-8 decoding errors.
}}
aws.xml.decodeToSoup : Bytes ->{Exception} Soup
aws.xml.decodeToSoup bytes =
  text = fromUtf8 bytes
  Soup.parseXML text

{{
Parse an HTTP response body as XML, returning a Soup cursor.

Decodes the response body bytes as UTF-8, then parses as XML.
Raises Exception if UTF-8 decoding fails.

Use this as the standard entry point in all response parsers instead
of calling Soup.parseXML directly.
}}
aws.xml.parseResponse : Http.Response -> '{Exception} Soup
aws.xml.parseResponse response = do
  aws.xml.decodeToSoup (Http.Response.body response)

{{
Parse XML text to a Soup cursor with Exception handling.

Unlike the basic `aws.xml.parse`, this function handles parsing errors
by converting XMLError to Exception Failure. This allows it to be used
in Exception-based error handling flows without explicit error conversion.

Example:
  soup = aws.xml.parseSoup xmlText
  -- Can now use soup with Exception-based functions

Raises Exception with XMLError if parsing fails.
}}
aws.xml.parseSoup : Text -> '{Exception} Soup
aws.xml.parseSoup xmlText = do
  match Soup.withXML xmlText (s -> Soup.root s) with
    Left err -> Exception.raise (Failure (typeLink XMLError) err (Any ()))
    Right [soup] -> soup
    Right _ -> Exception.raise (Failure (typeLink XMLError) "Failed to parse XML" (Any ()))

{{
Parse and process XML with error handling.

Wraps Soup.withXML to provide safe XML processing that returns
`Either Text [a]`: `Left` for errors, `Right` for results.

The callback function can use Each and Throw abilities.
}}
aws.xml.withXml : Text -> (Soup ->{Each, Throw XMLError} a) -> Either Text [a]
aws.xml.withXml = Soup.withXML

-- =============================================================================
-- Navigation Helpers
-- =============================================================================

{{
Get the root element of parsed XML.
}}
aws.xml.root : Soup -> Soup
aws.xml.root = Soup.root

{{
Find the first element with the given tag name.

Requires Throw XMLError ability - throws if element not found.
}}
aws.xml.find : Text -> Soup ->{Throw XMLError} Soup
aws.xml.find = Soup.findFirst

{{
Find an element, returning Optional instead of throwing.
}}
aws.xml.findOpt : Text -> Soup -> Optional Soup
aws.xml.findOpt tagName soup =
  throwToOptional do Soup.findFirst tagName soup

{{
Iterate over child elements (tags only, skips text nodes).

Uses Each ability - returns results via effect system.
}}
aws.xml.children : Soup ->{Each, Throw XMLError} Soup
aws.xml.children = Soup.childTags

{{
Filter elements by tag name.

Uses Each ability to iterate over matching elements.
}}
aws.xml.named : Text -> Soup ->{Each, Throw XMLError} Soup
aws.xml.named = Soup.named

{{
Iterate over all descendant elements.
}}
aws.xml.descendants : Soup ->{Each, Throw XMLError} Soup
aws.xml.descendants = Soup.descendants

{{
Drill down through multiple XML tags in sequence.

Takes a list of tag names and navigates through them in order.
Useful for navigating nested response wrappers like AWS Query.

Throws XMLError if any element in the path is not found.
}}
aws.xml.findAndDrill : Soup -> [Text] -> '{Throw XMLError} Soup
aws.xml.findAndDrill soup path = do
  List.foldLeft (s tag -> Soup.findFirst tag s) soup path

-- =============================================================================
-- Data Extraction (Soup-based)
-- =============================================================================

{{
Get the tag name of the current element.
}}
aws.xml.tagName : Soup ->{Throw XMLError} Text
aws.xml.tagName = Soup.tagName

{{
Get the text content of the current element.
}}
aws.xml.text : Soup ->{Throw XMLError} Text
aws.xml.text = Soup.text

{{
Get all text contents of the current element.
}}
aws.xml.texts : Soup ->{Throw XMLError} [Text]
aws.xml.texts = Soup.texts

{{
Get an attribute value from the current element.
}}
aws.xml.attr : Text -> Soup ->{Throw XMLError} Text
aws.xml.attr = Soup.getAttribute

{{
Get an attribute value as Optional.
}}
aws.xml.attrOpt : Text -> Soup -> Optional Text
aws.xml.attrOpt name soup =
  throwToOptional do Soup.getAttribute name soup

{{
Check if the current element has an attribute.
}}
aws.xml.hasAttr : Text -> Soup ->{Throw XMLError} Boolean
aws.xml.hasAttr = Soup.hasAttribute

-- =============================================================================
-- Convenience Extraction Functions
-- =============================================================================

{{
Find an element by name and get its text content.

Returns Optional - None if element not found.
}}
aws.xml.findText : Text -> Soup -> Optional Text
aws.xml.findText tagName soup =
  throwToOptional do
    elem = Soup.findFirst tagName soup
    Soup.text elem

{{
Find an element by name and get its text content as Int.

Returns Optional - None if element not found or not a valid integer.
}}
aws.xml.findInt : Text -> Soup -> Optional Int
aws.xml.findInt tagName soup =
  match aws.xml.findText tagName soup with
    None -> None
    Some text -> Int.fromText text

{{
Find an element by name and get its text content as Nat.

Returns Optional - None if element not found or not a valid natural number.
}}
aws.xml.findNat : Text -> Soup -> Optional Nat
aws.xml.findNat tagName soup =
  match aws.xml.findText tagName soup with
    None -> None
    Some text -> Nat.fromText text

{{
Find an element by name and get its text content as Boolean.

AWS XML uses lowercase "true" and "false".
Returns Optional - None if element not found or not a valid boolean.
}}
aws.xml.findBool : Text -> Soup -> Optional Boolean
aws.xml.findBool tagName soup =
  match aws.xml.findText tagName soup with
    None -> None
    Some "true" -> Some true
    Some "false" -> Some false
    _ -> None

{{
Find an element and get its attribute value.

Returns Optional - None if element or attribute not found.
}}
aws.xml.findAttr : Text -> Text -> Soup -> Optional Text
aws.xml.findAttr tagName attrName soup =
  throwToOptional do
    elem = Soup.findFirst tagName soup
    Soup.getAttribute attrName elem

-- =============================================================================
-- List Extraction
-- =============================================================================

{{
Extract all elements with a given name and get their text content.

Returns a list of text values from matching elements.
}}
aws.xml.findAllText : Text -> Soup -> [Text]
aws.xml.findAllText tagName soup =
  match Soup.withXML (Soup.toXML (Soup.root soup)) (s ->
      Soup.text (Soup.named tagName (Soup.root s))) with
    Left _ -> []
    Right texts -> texts

{{
Collect child elements as a list using a mapping function.

Processes each child element using the provided function.
}}
aws.xml.mapChildren : (Soup ->{Throw XMLError} a) -> Soup -> [a]
aws.xml.mapChildren f soup =
  match Soup.withXML (Soup.toXML (Soup.root soup)) (s ->
      f (Soup.childTags (Soup.root s))) with
    Left _ -> []
    Right results -> results

-- =============================================================================
-- Error Handling
-- =============================================================================

{{
Convert XMLError to Exception Failure.

Bridges @unison/xml error type to our Exception pattern.
}}
aws.xml.xmlErrorToFailure : XMLError -> Failure
aws.xml.xmlErrorToFailure err =
  Failure (typeLink XMLError) (XMLError.toText err) (Any err)

{{
Run an XML operation that may throw, converting to Exception.

This allows bridging Throw XMLError to Exception ability.
}}
aws.xml.runXml : '{Throw XMLError} a ->{Exception} a
aws.xml.runXml thunk =
  match Throw.toEither thunk with
    Left err -> Exception.raise (aws.xml.xmlErrorToFailure err)
    Right result -> result

{{
Run an XML operation returning Optional instead of throwing.
}}
aws.xml.tryXml : '{Throw XMLError} a -> Optional a
aws.xml.tryXml = throwToOptional

-- =============================================================================
-- XMLNode Helpers
-- =============================================================================

{{
Get the current position as an XMLNode.
}}
aws.xml.node : Soup ->{Throw XMLError} XMLNode
aws.xml.node = Soup.node

{{
Get all contents as XMLNode list.
}}
aws.xml.contents : Soup ->{Throw XMLError} [XMLNode]
aws.xml.contents = Soup.contents

{{
Convert XMLNode back to XML text.
}}
aws.xml.nodeToText : XMLNode -> Text
aws.xml.nodeToText = XMLNode.toXML

{{
Get children of an XMLNode.
}}
aws.xml.nodeChildren : XMLNode -> [XMLNode]
aws.xml.nodeChildren = XMLNode.children

{{
Get attributes of an XMLNode as a Map.
}}
aws.xml.nodeAttrs : XMLNode -> Map Text Text
aws.xml.nodeAttrs = XMLNode.attributes

-- =============================================================================
-- XML to Record Mapping
-- =============================================================================
-- 
-- These functions help map XML elements to Unison record types.
-- Since Unison doesn't have runtime reflection, generated code provides
-- specific parser functions for each structure type.
--
-- Pattern for generated parsers:
--   parseBucket : Soup -> Bucket
--   parseBucket soup = 
--     Bucket.Bucket
--       (aws.xml.findText "BucketArn" soup)
--       (aws.xml.findText "BucketRegion" soup)
--       (aws.xml.findText "CreationDate" soup)
--       (aws.xml.findText "Name" soup)
--

{{
Parse a list of child elements using a mapper function.

Finds all child elements with the given tag name and applies
the parser function to each one.

The parser function takes XML text, not Soup, for compatibility
with generated parsers.

Example:
  buckets = aws.xml.parseList "Bucket" parseBucketFromXml bucketsElem
}}
aws.xml.parseList : Text -> (Text -> a) -> Soup -> [a]
aws.xml.parseList tagName parser soup =
  xmlText = handle Soup.toXML soup with cases
    { x } -> x
    { Throw.throw _ -> _ } -> ""
  blocks = aws.xml.extractAllBlocks tagName xmlText
  List.map parser blocks

{{
Parse a list of child elements without filtering by tag name.

Maps over all direct child tags (not text nodes).

Example:
  items = aws.xml.parseChildList parseItem containerElem
}}
aws.xml.parseChildList : (Soup -> a) -> Soup -> [a]
aws.xml.parseChildList parser soup =
  -- Soup.root s is the [document] meta-node, not the serialized element.
  -- One childTags descends to the serialized element; a second descends to its children.
  match Soup.withXML (Soup.toXML soup) (s ->
      parser (Soup.childTags (Soup.childTags (Soup.root s)))) with
    Left _ -> []
    Right results -> results

{{
Parse a nested structure element.

Finds the element by name and applies the parser function.
Returns None if element not found.

The parser function takes XML text, not Soup, for compatibility
with generated parsers.

Example:
  owner = aws.xml.parseNested "Owner" parseOwnerFromXml response
}}
aws.xml.parseNested : Text -> (Text -> a) -> Soup -> Optional a
aws.xml.parseNested tagName parser soup =
  xmlText = handle Soup.toXML soup with cases
    { x } -> x
    { Throw.throw _ -> _ } -> ""
  block = aws.xml.extractBlock tagName xmlText
  if Text.isEmpty block then None
  else Some (parser block)

{{
Parse a nested structure that wraps a list.

Common S3 pattern where a container element holds a list:
<Buckets><Bucket>...</Bucket><Bucket>...</Bucket></Buckets>

The parser function takes XML text, not Soup, for compatibility
with generated parsers.

Example:
  buckets = aws.xml.parseWrappedList "Buckets" "Bucket" parseBucketFromXml response
}}
aws.xml.parseWrappedList : Text -> Text -> (Text -> a) -> Soup -> [a]
aws.xml.parseWrappedList containerTag itemTag parser soup =
  xmlText = handle Soup.toXML soup with cases
    { x } -> x
    { Throw.throw _ -> _ } -> ""
  containerXml = aws.xml.extractBlock containerTag xmlText
  if Text.isEmpty containerXml then []
  else aws.xml.parseListFromXml itemTag parser containerXml

{{
Parse a nested structure that wraps a list, returning Optional.

Returns `None` if the container element is not found. If the container is
present but has no child items, returns `Some` with an empty list.

The parser function takes XML text, not Soup, for compatibility
with generated parsers.

Example:
  buckets = aws.xml.parseOptionalWrappedList "Buckets" "Bucket" parseBucketFromXml response
}}
aws.xml.parseOptionalWrappedList : Text -> Text -> (Text -> a) -> Soup -> Optional [a]
aws.xml.parseOptionalWrappedList containerTag itemTag parser soup =
  xmlText = handle Soup.toXML soup with cases
    { x } -> x
    { Throw.throw _ -> _ } -> ""
  aws.xml.parseOptionalWrappedListFromXml containerTag itemTag parser xmlText

{{
Parse a flattened list (no container element).

Some AWS APIs use flattened lists where items appear directly:
<Item>...</Item><Item>...</Item>

The parser function takes XML text, not Soup, for compatibility
with generated parsers.

Example:
  items = aws.xml.parseFlatList "Item" parseItemFromXml response
}}
aws.xml.parseFlatList : Text -> (Text -> a) -> Soup -> [a]
aws.xml.parseFlatList = aws.xml.parseList

{{
Soup-native alias for flattened lists (same behaviour as parseListSoup).
}}
aws.xml.parseFlatListSoup : Text -> (Soup -> a) -> Soup ->{Exception} [a]
aws.xml.parseFlatListSoup = aws.xml.parseListSoup

{{
Parse a list of child elements using a Soup-based mapper function.

Finds all child elements with the given tag name and applies the parser
function to each Soup element directly, with no intermediate text conversion.

Example:
  items = aws.xml.parseListSoup "Item" parseItemFromSoup containerSoup

Uses aws.xml.runXml so this works inside Exception-based response parsers
(Soup.named and Soup.childTags require Throw XMLError from @unison/xml).
}}
aws.xml.parseListSoup : Text -> (Soup -> a) -> Soup ->{Exception} [a]
aws.xml.parseListSoup tagName parser soup =
  -- Soup.root s is the [document] meta-node, not the serialized element.
  -- One childTags descends to the serialized element; a second descends to its children.
  aws.xml.runXml do
    match Soup.withXML (Soup.toXML soup) (s ->
      parser (Soup.named tagName (Soup.childTags (Soup.childTags (Soup.root s))))) with
      Left _ -> []
      Right results -> results

{{
Parse an optional wrapped list using a Soup-based mapper function.

Returns `None` if the container element is not found. If the container
exists but has no matching child elements, returns `Some` with an empty list.
}}
aws.xml.parseOptionalWrappedListSoup : Text -> Text -> (Soup -> a) -> Soup ->{Exception} Optional [a]
aws.xml.parseOptionalWrappedListSoup containerTag itemTag parser soup =
  match aws.xml.findOpt containerTag soup with
    None -> None
    Some containerSoup -> Some (aws.xml.parseListSoup itemTag parser containerSoup)

{{
Parse a nested structure element using a Soup-based mapper function.

Finds the element by name and applies the parser to the Soup cursor.
Returns None if the element is not found.
}}
aws.xml.parseNestedSoup : Text -> (Soup -> a) -> Soup -> Optional a
aws.xml.parseNestedSoup tagName parser soup =
  match aws.xml.findOpt tagName soup with
    None -> None
    Some childSoup -> Some (parser childSoup)

{{
Extract a map from XML using Soup navigation.

Finds all entry elements within the container, then extracts key and value
text from each entry using Soup-based text finding.

Replaces the Soup.toXML + aws.xml.extractMap round-trip.
}}
aws.xml.extractMapSoup : Text -> Text -> Text -> Soup ->{Exception} [(Text, Text)]
aws.xml.extractMapSoup entryTag keyTag valueTag containerSoup =
  List.filter (cases (k, _) -> not (Text.isEmpty k))
    (aws.xml.parseListSoup entryTag (entrySoup ->
      ( Optional.getOrElse "" (aws.xml.findText keyTag entrySoup)
      , Optional.getOrElse "" (aws.xml.findText valueTag entrySoup)
      )) containerSoup)

-- =============================================================================
-- Field Extraction for Record Building
-- =============================================================================

{{
Extract a required text field, throwing if not found.

Use this for required fields in generated parsers.
}}
aws.xml.requireText : Text -> Soup ->{Exception} Text
aws.xml.requireText tagName soup =
  match aws.xml.findText tagName soup with
    Some text -> text
    None -> Exception.raise (Failure (typeLink XMLError) ("Required element not found: " ++ tagName) (Any tagName))

{{
Extract a required integer field, throwing if not found or invalid.
}}
aws.xml.requireInt : Text -> Soup ->{Exception} Int
aws.xml.requireInt tagName soup =
  match aws.xml.findInt tagName soup with
    Some n -> n
    None -> Exception.raise (Failure (typeLink XMLError) ("Required integer element not found: " ++ tagName) (Any tagName))

{{
Extract a required Nat field, throwing if not found or invalid.
}}
aws.xml.requireNat : Text -> Soup ->{Exception} Nat
aws.xml.requireNat tagName soup =
  match aws.xml.findNat tagName soup with
    Some n -> n
    None -> Exception.raise (Failure (typeLink XMLError) ("Required Nat element not found: " ++ tagName) (Any tagName))

{{
Extract a required boolean field, throwing if not found or invalid.
}}
aws.xml.requireBool : Text -> Soup ->{Exception} Boolean
aws.xml.requireBool tagName soup =
  match aws.xml.findBool tagName soup with
    Some b -> b
    None -> Exception.raise (Failure (typeLink XMLError) ("Required boolean element not found: " ++ tagName) (Any tagName))

-- =============================================================================
-- Building XML (using @unison/xml)
-- =============================================================================

{{
Create an XML element node.
}}
aws.xml.xmlElement : Text -> Map Text Text -> [XMLNode] -> XMLNode
aws.xml.xmlElement = XMLNode.XMLElement

{{
Create an XML text node.
}}
aws.xml.xmlText : Text -> XMLNode
aws.xml.xmlText = XMLNode.XMLText

{{
Create an XML element with just a name (no attributes or children).
}}
aws.xml.xmlTag : Text -> XMLNode
aws.xml.xmlTag = XMLNode.elementNamed

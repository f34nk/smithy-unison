-- Unit tests for AWS Environment Ability Runtime Module

namespace aws.env.test

use Text ++

-- === extractQueryString Tests ===

testExtractQueryStringWithQuery : '{Exception} Boolean
testExtractQueryStringWithQuery = 'let
  url = "https://example.com/path?key=value&other=123"
  aws.env.extractQueryString url === "key=value&other=123"

testExtractQueryStringNoQuery : '{Exception} Boolean
testExtractQueryStringNoQuery = 'let
  url = "https://example.com/path"
  aws.env.extractQueryString url === ""

testExtractQueryStringEmptyQuery : '{Exception} Boolean
testExtractQueryStringEmptyQuery = 'let
  url = "https://example.com/path?"
  aws.env.extractQueryString url === ""

testExtractQueryStringMultipleQuestionMarks : '{Exception} Boolean
testExtractQueryStringMultipleQuestionMarks = 'let
  -- Should extract everything after the first ?
  url = "https://example.com/path?key=value?other"
  aws.env.extractQueryString url === "key=value?other"

testExtractQueryStringOnlyDomain : '{Exception} Boolean
testExtractQueryStringOnlyDomain = 'let
  url = "https://example.com"
  aws.env.extractQueryString url === ""

-- === AWSEnv Handler Tests ===

-- Test that AWSEnv.handler correctly provides the region
testHandlerRegion : '{IO, Exception} Boolean
testHandlerRegion = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  result =
    handle
      AWSEnv.region
    with AWSEnv.handler "us-west-2" creds
  result === "us-west-2"

testHandlerRegionEuCentral : '{IO, Exception} Boolean
testHandlerRegionEuCentral = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  result =
    handle
      AWSEnv.region
    with AWSEnv.handler "eu-central-1" creds
  result === "eu-central-1"

testHandlerSignAddsHeaders : '{IO, Exception} Boolean
testHandlerSignAddsHeaders = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  baseRequest = Http.Request.post "https://lambda.us-east-1.amazonaws.com/" [] Bytes.empty
  result =
    handle
      AWSEnv.sign "lambda" baseRequest
    with AWSEnv.handler "us-east-1" creds
  -- Check that signing headers were added
  headers = Http.Request.headers result
  hasAuthHeader = aws.http.hasHeader "Authorization" headers
  hasDateHeader = aws.http.hasHeader "x-amz-date" headers
  hasContentSha = aws.http.hasHeader "x-amz-content-sha256" headers
  hasAuthHeader && hasDateHeader && hasContentSha

testHandlerSignPreservesRequest : '{IO, Exception} Boolean
testHandlerSignPreservesRequest = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  body = toUtf8 "{\"key\":\"value\"}"
  originalHeaders = [("Content-Type", "application/json")]
  baseRequest = Http.Request.post "https://dynamodb.us-west-2.amazonaws.com/" originalHeaders body
  result =
    handle
      AWSEnv.sign "dynamodb" baseRequest
    with AWSEnv.handler "us-west-2" creds
  -- Method and URL should be preserved
  test1 = Http.Request.method result === "POST"
  test2 = Http.Request.url result === "https://dynamodb.us-west-2.amazonaws.com/"
  test3 = Http.Request.body result === body
  -- Original headers should still be present
  test4 = aws.http.hasHeader "Content-Type" (Http.Request.headers result)
  test1 && test2 && test3 && test4

testHandlerChainedOperations : '{IO, Exception} Boolean
testHandlerChainedOperations = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  result =
    handle
      region = AWSEnv.region
      baseRequest = Http.Request.get ("https://s3." ++ region ++ ".amazonaws.com/bucket") []
      signedRequest = AWSEnv.sign "s3" baseRequest
      (region, Http.Request.headers signedRequest)
    with AWSEnv.handler "ap-southeast-1" creds
  (regionResult, headers) = result
  test1 = regionResult === "ap-southeast-1"
  test2 = aws.http.hasHeader "Authorization" headers
  test1 && test2

testHandlerWithSessionToken : '{IO, Exception} Boolean
testHandlerWithSessionToken = 'let
  creds = aws.config.temporaryCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY" "session-token"
  baseRequest = Http.Request.post "https://sts.amazonaws.com/" [] Bytes.empty
  result =
    handle
      AWSEnv.sign "sts" baseRequest
    with AWSEnv.handler "us-east-1" creds
  headers = Http.Request.headers result
  -- Should have the security token header when session token is present
  aws.http.hasHeader "x-amz-security-token" headers

testHandlerWithAnonymousCredentials : '{IO, Exception} Boolean
testHandlerWithAnonymousCredentials = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  baseRequest = Http.Request.get "https://s3.us-east-1.amazonaws.com/bucket" []
  result =
    handle
      AWSEnv.sign "s3" baseRequest
    with AWSEnv.handler "us-east-1" creds
  headers = Http.Request.headers result
  -- Should NOT have security token header with basic credentials
  not (aws.http.hasHeader "x-amz-security-token" headers)

-- === signRequest Internal Function Tests ===

testSignRequestAddsAuthorizationHeader : '{IO, Exception} Boolean
testSignRequestAddsAuthorizationHeader = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  baseRequest = Http.Request.post "https://kinesis.us-east-1.amazonaws.com/" [] Bytes.empty
  result = aws.env.signRequest "us-east-1" "kinesis" creds baseRequest
  headers = Http.Request.headers result
  authHeader = aws.http.getHeader "Authorization" headers
  match authHeader with
    Some value -> Text.contains "AWS4-HMAC-SHA256" value
    None -> false

testSignRequestAddsAmzDateHeader : '{IO, Exception} Boolean
testSignRequestAddsAmzDateHeader = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  baseRequest = Http.Request.post "https://sqs.eu-west-1.amazonaws.com/" [] Bytes.empty
  result = aws.env.signRequest "eu-west-1" "sqs" creds baseRequest
  headers = Http.Request.headers result
  dateHeader = aws.http.getHeader "x-amz-date" headers
  match dateHeader with
    Some value -> 
      -- Should be in ISO 8601 format: YYYYMMDDTHHMMSSZ
      (Text.size value === 16) && (Text.contains "T" value) && (Text.endsWith "Z" value)
    None -> false

testSignRequestAddsContentSha256Header : '{IO, Exception} Boolean
testSignRequestAddsContentSha256Header = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  body = toUtf8 "{\"test\":\"data\"}"
  baseRequest = Http.Request.post "https://dynamodb.us-east-1.amazonaws.com/" [] body
  result = aws.env.signRequest "us-east-1" "dynamodb" creds baseRequest
  headers = Http.Request.headers result
  sha256Header = aws.http.getHeader "x-amz-content-sha256" headers
  match sha256Header with
    Some value -> Text.size value === 64  -- SHA256 hex digest is 64 chars
    None -> false

testSignRequestPreservesOriginalHeaders : '{IO, Exception} Boolean
testSignRequestPreservesOriginalHeaders = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  originalHeaders = [("Content-Type", "application/x-amz-json-1.1"), ("X-Amz-Target", "Kinesis.ListStreams")]
  baseRequest = Http.Request.post "https://kinesis.us-east-1.amazonaws.com/" originalHeaders Bytes.empty
  result = aws.env.signRequest "us-east-1" "kinesis" creds baseRequest
  headers = Http.Request.headers result
  test1 = aws.http.getHeader "Content-Type" headers === Some "application/x-amz-json-1.1"
  test2 = aws.http.getHeader "X-Amz-Target" headers === Some "Kinesis.ListStreams"
  test1 && test2


testDifferentServicesGetDifferentSignatures : '{IO, Exception} Boolean
testDifferentServicesGetDifferentSignatures = 'let
  creds = aws.config.basicCredentials "AKIAIOSFODNN7EXAMPLE" "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  baseRequest = Http.Request.post "https://example.amazonaws.com/" [] Bytes.empty
  
  lambdaResult =
    handle
      AWSEnv.sign "lambda" baseRequest
    with AWSEnv.handler "us-east-1" creds
  
  s3Result =
    handle
      AWSEnv.sign "s3" baseRequest
    with AWSEnv.handler "us-east-1" creds
  
  lambdaAuth = aws.http.getHeader "Authorization" (Http.Request.headers lambdaResult)
  s3Auth = aws.http.getHeader "Authorization" (Http.Request.headers s3Result)
  
  -- Different services should produce different Authorization headers
  match (lambdaAuth, s3Auth) with
    (Some lambdaValue, Some s3Value) -> 
      -- Both should contain their respective service names in the credential scope
      (Text.contains "lambda" lambdaValue) && (Text.contains "s3" s3Value)
    _ -> false

-- === Test Runner ===

runAllTests : '{IO, Exception} ()
runAllTests = do
  printLine "Running AWS Env Runtime Tests..."
  printLine ""
  
  -- extractQueryString tests
  runTest "extractQueryString with query" testExtractQueryStringWithQuery ()
  runTest "extractQueryString no query" testExtractQueryStringNoQuery ()
  runTest "extractQueryString empty query" testExtractQueryStringEmptyQuery ()
  runTest "extractQueryString multiple question marks" testExtractQueryStringMultipleQuestionMarks ()
  runTest "extractQueryString only domain" testExtractQueryStringOnlyDomain ()
  
  -- Handler region tests
  runTest "handler region" testHandlerRegion ()
  runTest "handler region eu-central" testHandlerRegionEuCentral ()
  
  -- Handler sign tests
  runTest "handler sign adds headers" testHandlerSignAddsHeaders ()
  runTest "handler sign preserves request" testHandlerSignPreservesRequest ()
  runTest "handler chained operations" testHandlerChainedOperations ()
  runTest "handler with session token" testHandlerWithSessionToken ()
  runTest "handler without session token" testHandlerWithAnonymousCredentials ()
  
  -- signRequest internal function tests
  runTest "signRequest adds Authorization header" testSignRequestAddsAuthorizationHeader ()
  runTest "signRequest adds x-amz-date header" testSignRequestAddsAmzDateHeader ()
  runTest "signRequest adds x-amz-content-sha256 header" testSignRequestAddsContentSha256Header ()
  runTest "signRequest preserves original headers" testSignRequestPreservesOriginalHeaders ()
  
  -- Multiple services tests
  runTest "different services get different signatures" testDifferentServicesGetDifferentSignatures ()
  
  printLine ""
  printLine "All tests completed!"

runTest : Text -> '{IO, Exception} Boolean -> '{IO, Exception} ()
runTest name test = do
  result = if test () then "✓ PASS" else "✗ FAIL"
  printLine (result ++ " - " ++ name)

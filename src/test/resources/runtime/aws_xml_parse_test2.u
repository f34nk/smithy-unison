-- Test extracting individual elements
testExtractElement : '{IO, Exception} ()
testExtractElement = do
  printLine "=== Testing aws.xml.extractElement ==="
  printLine ""
  
  -- Test extracting vpcId (lowercase)
  vpcIdLower = aws.xml.extractElementOpt "vpcId" sampleVpcItemXml
  printLine ("extractElementOpt \"vpcId\": " ++ Optional.getOrElse "NONE" vpcIdLower)
  
  -- Test extracting VpcId (PascalCase) - should NOT work with LocalStack XML
  vpcIdUpper = aws.xml.extractElementOpt "VpcId" sampleVpcItemXml
  printLine ("extractElementOpt \"VpcId\": " ++ Optional.getOrElse "NONE" vpcIdUpper)
  
  -- Test other fields
  ownerId = aws.xml.extractElementOpt "ownerId" sampleVpcItemXml
  printLine ("extractElementOpt \"ownerId\": " ++ Optional.getOrElse "NONE" ownerId)
  
  cidrBlock = aws.xml.extractElementOpt "cidrBlock" sampleVpcItemXml
  printLine ("extractElementOpt \"cidrBlock\": " ++ Optional.getOrElse "NONE" cidrBlock)
  
  state = aws.xml.extractElementOpt "state" sampleVpcItemXml
  printLine ("extractElementOpt \"state\": " ++ Optional.getOrElse "NONE" state)
  
  isDefault = aws.xml.extractElementOpt "isDefault" sampleVpcItemXml
  printLine ("extractElementOpt \"isDefault\": " ++ Optional.getOrElse "NONE" isDefault)
  printLine ""

-- Test extractAll for list items
testExtractAllBlocks : '{IO, Exception} ()
testExtractAllBlocks = do
  printLine "=== Testing aws.xml.extractAllBlocks ==="
  printLine ""
  
  -- Extract all <item> blocks from vpcSet (single line for simplicity)
  vpcSetXml = "<vpcSet><item><vpcId>vpc-1</vpcId></item><item><vpcId>vpc-2</vpcId></item></vpcSet>"
  
  printLine ("Input XML: " ++ vpcSetXml)
  printLine ""
  
  blocks = aws.xml.extractAllBlocks "item" vpcSetXml
  printLine ("Found " ++ Nat.toText (List.size blocks) ++ " <item> blocks")
  printBlocks blocks
  printLine ""

-- Security Group sample XML
sampleSecurityGroupXml : Text
sampleSecurityGroupXml = """<item>
  <groupId>sg-12345678</groupId>
  <groupName>default</groupName>
  <groupDescription>default VPC security group</groupDescription>
  <vpcId>vpc-12345678</vpcId>
  <ownerId>000000000000</ownerId>
  <ipPermissions/>
  <ipPermissionsEgress/>
</item>"""

-- Test parsing security group
testParseSecurityGroup : '{IO, Exception} ()
testParseSecurityGroup = do
  printLine "=== Testing SecurityGroup parsing ==="
  printLine ""
  printLine "Input XML:"
  printLine sampleSecurityGroupXml
  printLine ""
  
  -- Test extracting fields directly
  groupId = aws.xml.extractElementOpt "groupId" sampleSecurityGroupXml
  groupName = aws.xml.extractElementOpt "groupName" sampleSecurityGroupXml
  groupDescription = aws.xml.extractElementOpt "groupDescription" sampleSecurityGroupXml
  vpcId = aws.xml.extractElementOpt "vpcId" sampleSecurityGroupXml
  
  printLine "Direct extraction results:"
  printLine ("  groupId: " ++ Optional.getOrElse "NONE" groupId)
  printLine ("  groupName: " ++ Optional.getOrElse "NONE" groupName)
  printLine ("  groupDescription: " ++ Optional.getOrElse "NONE" groupDescription)
  printLine ("  vpcId: " ++ Optional.getOrElse "NONE" vpcId)
  printLine ""
  
  -- Also test PascalCase to show they don't match
  printLine "PascalCase extraction (should fail):"
  printLine ("  GroupId: " ++ Optional.getOrElse "NONE" (aws.xml.extractElementOpt "GroupId" sampleSecurityGroupXml))
  printLine ("  GroupName: " ++ Optional.getOrElse "NONE" (aws.xml.extractElementOpt "GroupName" sampleSecurityGroupXml))
  printLine ""

-- Run all tests
runParseTests : '{IO, Exception} ()
runParseTests = do
  printLine "╔══════════════════════════════════════════════════╗"
  printLine "║       EC2 XML Parsing Isolation Tests            ║"
  printLine "╚══════════════════════════════════════════════════╝"
  printLine ""
  
  !testExtractElement
  !testExtractAllBlocks
  !testParseSecurityGroup
  -- !testParseVpcFromXml
  
  printLine "╔══════════════════════════════════════════════════╗"
  printLine "║               Tests Complete                      ║"
  printLine "╚══════════════════════════════════════════════════╝"

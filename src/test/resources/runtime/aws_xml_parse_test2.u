-- EC2 XML Parsing Tests
-- Tests the XML parsing functions against sample LocalStack XML responses

-- Sample XML responses from LocalStack (based on actual responses)

namespace aws.xml.parse.test2

-- DescribeVpcs response sample
sampleDescribeVpcsResponse : Text
sampleDescribeVpcsResponse = "<?xml version='1.0' encoding='utf-8'?><DescribeVpcsResponse xmlns=\"http://ec2.amazonaws.com/doc/2016-11-15/\"><vpcSet><item><vpcId>vpc-12345678</vpcId><ownerId>000000000000</ownerId><state>available</state><cidrBlock>10.0.0.0/16</cidrBlock><cidrBlockAssociationSet><item><cidrBlock>10.0.0.0/16</cidrBlock><associationId>vpc-cidr-assoc-12345</associationId><cidrBlockState><state>associated</state></cidrBlockState></item></cidrBlockAssociationSet><isDefault>false</isDefault><tagSet/><instanceTenancy>default</instanceTenancy></item></vpcSet><requestId>test-request-id</requestId></DescribeVpcsResponse>"

-- Extract just the VPC item XML for isolated testing
sampleVpcItemXml : Text
sampleVpcItemXml = "<item><vpcId>vpc-12345678</vpcId><ownerId>000000000000</ownerId><state>available</state><cidrBlock>10.0.0.0/16</cidrBlock><isDefault>false</isDefault><instanceTenancy>default</instanceTenancy></item>"

-- Helper to print blocks without ambiguous List.foreach
printBlocks : [Text] ->{IO, Exception} ()
printBlocks blocks =
  go idx items = match items with
    [] -> ()
    head +: tail ->
      printLine ("  Block " ++ Nat.toText idx ++ ": " ++ head)
      go (idx Nat.+ 1) tail
  go 0 blocks


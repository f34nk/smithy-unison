-- Unit tests for AWS JSON Runtime Module

use Aws.Json
use Bytes

-- === JSON Serialization Tests ===

testToJsonString : Boolean
testToJsonString =
  result = toJson (JsonString "hello")
  result === "\"hello\""

testToJsonNumber : Boolean
testToJsonNumber =
  result = toJson (JsonNumber 42.0)
  result === "42.0"

testToJsonBoolean : Boolean
testToJsonBoolean =
  (toJson (JsonBoolean true) === "true") &&
  (toJson (JsonBoolean false) === "false")

testToJsonNull : Boolean
testToJsonNull =
  toJson JsonNull === "null"

testToJsonObject : Boolean
testToJsonObject =
  obj = JsonObject [("name", JsonString "Alice"), ("age", JsonNumber 30.0)]
  result = toJson obj
  (result === "{\"name\":\"Alice\",\"age\":30.0}") ||
  (result === "{\"age\":30.0,\"name\":\"Alice\"}")

testToJsonArray : Boolean
testToJsonArray =
  arr = JsonArray [JsonString "a", JsonString "b", JsonNumber 1.0]
  result = toJson arr
  result === "[\"a\",\"b\",1.0]"

testToJsonNestedObject : Boolean
testToJsonNestedObject =
  inner = JsonObject [("city", JsonString "NYC")]
  outer = JsonObject [("person", inner)]
  result = toJson outer
  result === "{\"person\":{\"city\":\"NYC\"}}"

testToJsonEscaping : Boolean
testToJsonEscaping =
  str = JsonString "line1\nline2\ttab\"quote"
  result = toJson str
  result === "\"line1\\nline2\\ttab\\\"quote\""

-- === JSON Deserialization Tests ===

testFromJsonString : Boolean
testFromJsonString =
  match fromJson "\"hello\"" with
    Some (JsonString "hello") -> true
    _ -> false

testFromJsonNumber : Boolean
testFromJsonNumber =
  match fromJson "42.5" with
    Some (JsonNumber n) -> n === 42.5
    _ -> false

testFromJsonBoolean : Boolean
testFromJsonBoolean =
  match fromJson "true" with
    Some (JsonBoolean true) -> true
    _ -> false

testFromJsonNull : Boolean
testFromJsonNull =
  match fromJson "null" with
    Some JsonNull -> true
    _ -> false

testFromJsonObject : Boolean
testFromJsonObject =
  json = "{\"name\":\"Alice\",\"age\":30}"
  match fromJson json with
    Some (JsonObject fields) ->
      (getFieldAsString "name" (JsonObject fields) === Some "Alice") &&
      (getFieldAsNumber "age" (JsonObject fields) === Some 30.0)
    _ -> false

testFromJsonArray : Boolean
testFromJsonArray =
  json = "[\"a\",\"b\",1]"
  match fromJson json with
    Some (JsonArray items) -> List.size items === 3
    _ -> false

testFromJsonEmptyObject : Boolean
testFromJsonEmptyObject =
  match fromJson "{}" with
    Some (JsonObject fields) -> List.isEmpty fields
    _ -> false

testFromJsonEmptyArray : Boolean
testFromJsonEmptyArray =
  match fromJson "[]" with
    Some (JsonArray items) -> List.isEmpty items
    _ -> false

testFromJsonWhitespace : Boolean
testFromJsonWhitespace =
  json = "  { \"key\" : \"value\" }  "
  match fromJson json with
    Some (JsonObject fields) -> 
      getFieldAsString "key" (JsonObject fields) === Some "value"
    _ -> false

testFromJsonNested : Boolean
testFromJsonNested =
  json = "{\"outer\":{\"inner\":\"value\"}}"
  match fromJson json with
    Some (JsonObject fields) ->
      match getFieldAsObject "outer" (JsonObject fields) with
        Some inner -> getFieldAsString "inner" inner === Some "value"
        _ -> false
    _ -> false

-- === Object Accessor Tests ===

testGetField : Boolean
testGetField =
  obj = JsonObject [("key", JsonString "value")]
  match getField "key" obj with
    Some (JsonString "value") -> true
    _ -> false

testGetFieldMissing : Boolean
testGetFieldMissing =
  obj = JsonObject [("key", JsonString "value")]
  getField "missing" obj === None

testGetFieldOrNull : Boolean
testGetFieldOrNull =
  obj = JsonObject [("key", JsonString "value")]
  (getFieldOrNull "key" obj |> cases JsonString "value" -> true; _ -> false) &&
  (getFieldOrNull "missing" obj |> cases JsonNull -> true; _ -> false)

testGetFieldAsString : Boolean
testGetFieldAsString =
  obj = JsonObject [("name", JsonString "Alice")]
  getFieldAsString "name" obj === Some "Alice"

testGetFieldAsNumber : Boolean
testGetFieldAsNumber =
  obj = JsonObject [("age", JsonNumber 30.0)]
  getFieldAsNumber "age" obj === Some 30.0

testGetFieldAsBoolean : Boolean
testGetFieldAsBoolean =
  obj = JsonObject [("active", JsonBoolean true)]
  getFieldAsBoolean "active" obj === Some true

testGetFieldAsArray : Boolean
testGetFieldAsArray =
  obj = JsonObject [("items", JsonArray [JsonString "a", JsonString "b"])]
  match getFieldAsArray "items" obj with
    Some items -> List.size items === 2
    _ -> false

-- === AttributeValue Tests ===

testAttributeValueString : Boolean
testAttributeValueString =
  attr = AttributeValue'S "hello"
  json = attributeValueToJson attr
  match json with
    JsonObject fields ->
      (List.size fields === 1) &&
      (getFieldAsString "S" json === Some "hello")
    _ -> false

testAttributeValueNumber : Boolean
testAttributeValueNumber =
  attr = AttributeValue'N "123.45"
  json = attributeValueToJson attr
  match json with
    JsonObject fields ->
      (List.size fields === 1) &&
      (getFieldAsString "N" json === Some "123.45")
    _ -> false

testAttributeValueBoolean : Boolean
testAttributeValueBoolean =
  attr = AttributeValue'BOOL true
  json = attributeValueToJson attr
  match json with
    JsonObject fields ->
      (List.size fields === 1) &&
      (getFieldAsBoolean "BOOL" json === Some true)
    _ -> false

testAttributeValueNull : Boolean
testAttributeValueNull =
  attr = AttributeValue'NULL true
  json = attributeValueToJson attr
  toJson json === "{\"NULL\":true}"

testAttributeValueStringSet : Boolean
testAttributeValueStringSet =
  attr = AttributeValue'SS ["a", "b", "c"]
  json = attributeValueToJson attr
  toJson json === "{\"SS\":[\"a\",\"b\",\"c\"]}"

testAttributeValueMap : Boolean
testAttributeValueMap =
  attr = AttributeValue'M [
    ("name", AttributeValue'S "Alice"),
    ("age", AttributeValue'N "30")
  ]
  json = attributeValueToJson attr
  match json with
    JsonObject fields ->
      match getFieldAsObject "M" json with
        Some m -> 
          (getFieldAsString "name" m === None) && -- Because it's wrapped in {"S": "Alice"}
          true
        _ -> false
    _ -> false

testAttributeValueList : Boolean
testAttributeValueList =
  attr = AttributeValue'L [
    AttributeValue'S "first",
    AttributeValue'N "2",
    AttributeValue'BOOL true
  ]
  json = attributeValueToJson attr
  match json with
    JsonObject fields ->
      match getFieldAsArray "L" json with
        Some items -> List.size items === 3
        _ -> false
    _ -> false

testJsonToAttributeValueString : Boolean
testJsonToAttributeValueString =
  json = JsonObject [("S", JsonString "hello")]
  match jsonToAttributeValue json with
    Some (AttributeValue'S "hello") -> true
    _ -> false

testJsonToAttributeValueNumber : Boolean
testJsonToAttributeValueNumber =
  json = JsonObject [("N", JsonString "123")]
  match jsonToAttributeValue json with
    Some (AttributeValue'N "123") -> true
    _ -> false

testJsonToAttributeValueBoolean : Boolean
testJsonToAttributeValueBoolean =
  json = JsonObject [("BOOL", JsonBoolean false)]
  match jsonToAttributeValue json with
    Some (AttributeValue'BOOL false) -> true
    _ -> false

testJsonToAttributeValueNull : Boolean
testJsonToAttributeValueNull =
  json = JsonObject [("NULL", JsonBoolean true)]
  match jsonToAttributeValue json with
    Some (AttributeValue'NULL true) -> true
    _ -> false

testJsonToAttributeValueStringSet : Boolean
testJsonToAttributeValueStringSet =
  json = JsonObject [("SS", JsonArray [JsonString "a", JsonString "b"])]
  match jsonToAttributeValue json with
    Some (AttributeValue'SS items) -> List.size items === 2
    _ -> false

-- === Roundtrip Tests ===

testRoundtripString : Boolean
testRoundtripString =
  original = JsonString "hello world"
  serialized = toJson original
  match fromJson serialized with
    Some (JsonString "hello world") -> true
    _ -> false

testRoundtripNumber : Boolean
testRoundtripNumber =
  original = JsonNumber 42.5
  serialized = toJson original
  match fromJson serialized with
    Some (JsonNumber n) -> n === 42.5
    _ -> false

testRoundtripObject : Boolean
testRoundtripObject =
  original = JsonObject [("key", JsonString "value"), ("num", JsonNumber 10.0)]
  serialized = toJson original
  match fromJson serialized with
    Some (JsonObject fields) ->
      (getFieldAsString "key" (JsonObject fields) === Some "value") &&
      (getFieldAsNumber "num" (JsonObject fields) === Some 10.0)
    _ -> false

testRoundtripArray : Boolean
testRoundtripArray =
  original = JsonArray [JsonString "a", JsonNumber 1.0, JsonBoolean true, JsonNull]
  serialized = toJson original
  match fromJson serialized with
    Some (JsonArray items) -> List.size items === 4
    _ -> false

testAttributeValueRoundtrip : Boolean
testAttributeValueRoundtrip =
  original = AttributeValue'M [
    ("id", AttributeValue'S "user123"),
    ("age", AttributeValue'N "30"),
    ("active", AttributeValue'BOOL true)
  ]
  json = attributeValueToJson original
  serialized = toJson json
  match fromJson serialized with
    Some parsed ->
      match jsonToAttributeValue parsed with
        Some (AttributeValue'M fields) -> List.size fields === 3
        _ -> false
    _ -> false

-- === Test Runner ===

runAllTests : '{IO, Exception} ()
runAllTests = do
  printLine "Running AWS JSON Runtime Tests..."
  printLine ""
  
  -- Serialization tests
  runTest "toJson String" testToJsonString
  runTest "toJson Number" testToJsonNumber
  runTest "toJson Boolean" testToJsonBoolean
  runTest "toJson Null" testToJsonNull
  runTest "toJson Object" testToJsonObject
  runTest "toJson Array" testToJsonArray
  runTest "toJson Nested Object" testToJsonNestedObject
  runTest "toJson Escaping" testToJsonEscaping
  
  -- Deserialization tests
  runTest "fromJson String" testFromJsonString
  runTest "fromJson Number" testFromJsonNumber
  runTest "fromJson Boolean" testFromJsonBoolean
  runTest "fromJson Null" testFromJsonNull
  runTest "fromJson Object" testFromJsonObject
  runTest "fromJson Array" testFromJsonArray
  runTest "fromJson Empty Object" testFromJsonEmptyObject
  runTest "fromJson Empty Array" testFromJsonEmptyArray
  runTest "fromJson Whitespace" testFromJsonWhitespace
  runTest "fromJson Nested" testFromJsonNested
  
  -- Accessor tests
  runTest "getField" testGetField
  runTest "getField Missing" testGetFieldMissing
  runTest "getFieldOrNull" testGetFieldOrNull
  runTest "getFieldAsString" testGetFieldAsString
  runTest "getFieldAsNumber" testGetFieldAsNumber
  runTest "getFieldAsBoolean" testGetFieldAsBoolean
  runTest "getFieldAsArray" testGetFieldAsArray
  
  -- AttributeValue tests
  runTest "AttributeValue String" testAttributeValueString
  runTest "AttributeValue Number" testAttributeValueNumber
  runTest "AttributeValue Boolean" testAttributeValueBoolean
  runTest "AttributeValue Null" testAttributeValueNull
  runTest "AttributeValue StringSet" testAttributeValueStringSet
  runTest "AttributeValue Map" testAttributeValueMap
  runTest "AttributeValue List" testAttributeValueList
  runTest "jsonToAttributeValue String" testJsonToAttributeValueString
  runTest "jsonToAttributeValue Number" testJsonToAttributeValueNumber
  runTest "jsonToAttributeValue Boolean" testJsonToAttributeValueBoolean
  runTest "jsonToAttributeValue Null" testJsonToAttributeValueNull
  runTest "jsonToAttributeValue StringSet" testJsonToAttributeValueStringSet
  
  -- Roundtrip tests
  runTest "Roundtrip String" testRoundtripString
  runTest "Roundtrip Number" testRoundtripNumber
  runTest "Roundtrip Object" testRoundtripObject
  runTest "Roundtrip Array" testRoundtripArray
  runTest "AttributeValue Roundtrip" testAttributeValueRoundtrip
  
  printLine ""
  printLine "All tests completed!"

runTest : Text -> Boolean -> '{IO} ()
runTest name test = do
  result = if test then "✓ PASS" else "✗ FAIL"
  printLine (result ++ " - " ++ name)

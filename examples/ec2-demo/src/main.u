-- EC2 Demo Application
-- Tests the generated EC2 client using AWSEnv ability
--
-- REQUIREMENTS:
-- Set environment variables: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
-- Optionally AWS_SESSION_TOKEN for temporary credentials

-- =============================================================================
-- Helpers
-- =============================================================================

-- Get environment variable with a default value
envOrDefault : Text -> Text -> '{IO, Exception} Text
envOrDefault name default = do
  result = catch do getEnv name
  match result with
    Either.Left _ -> default
    Either.Right value -> if Text.isEmpty value then default else value

-- Create basic credentials, using env vars when present, otherwise defaults
defaultCredentials : '{IO, Exception} aws.config.Credentials
defaultCredentials = do
  key = !(envOrDefault "AWS_ACCESS_KEY_ID" "dummy")
  secret = !(envOrDefault "AWS_SECRET_ACCESS_KEY" "dummy")
  aws.config.basicCredentials key secret

-- Fail if a parsed value is "unknown" (indicates parsing failure)
requireParsed : Text -> Text -> '{g} ()
requireParsed fieldName value = do
  if Text.eq value "unknown" then
    bug ("Parsing failed: " ++ fieldName ++ " returned 'unknown'")
  else ()

-- =============================================================================
-- Main Demo
-- =============================================================================

-- Entry point for UCM compile - must have '{IO, Exception} signature
main : '{IO, Exception} ()
main = do
  printLine "╔══════════════════════════════════════════════╗"
  printLine "║     EC2 Client Demo (AWSEnv Ability)        ║"
  printLine "╚══════════════════════════════════════════════╝"
  printLine ""
  region = !(envOrDefault "AWS_REGION" "us-east-1")
  creds = !defaultCredentials
  endpointEnv = getEnv "AWS_ENDPOINT"
  endpoint = if Text.isEmpty endpointEnv then None else Some endpointEnv
  
  -- Run demo with AWSEnv, Http and Threads abilities using provided defaults
  -- Threads.run requires Random, so wrap with Random.run
  Random.run do
    systemfw_concurrent_7_3_0.Threads.run do
      handle
        Http.run do
          regionVal = AWSEnv.region
          printLine ("Region: " ++ regionVal)
          printLine ""
          
          -- Demo 1: Describe VPCs
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 1: Describe VPCs"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !describeVpcsDemo
          
          -- Demo 2: Describe Subnets
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 2: Describe Subnets"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !describeSubnetsDemo
          
          -- Demo 3: Describe Security Groups
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 3: Describe Security Groups"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !describeSecurityGroupsDemo
          
          -- Demo 4: Run Instances
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 4: Run Instances"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !runInstancesDemo
          
          -- Demo 5: Describe Instances (should now show the instance we just launched)
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 5: Describe Instances"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !describeInstancesDemo
          
          printLine ""
          printLine "╔══════════════════════════════════════════════╗"
          printLine "║           EC2 Demo Complete!                 ║"
          printLine "╚══════════════════════════════════════════════╝"
      with AWSEnv.handler region creds endpoint

-- =============================================================================
-- Demo Functions
-- =============================================================================

{{
Describe VPCs created by Terraform.
}}
describeVpcsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
describeVpcsDemo = do
  printLine "  → Calling DescribeVpcs..."
  
  -- Create request with empty options (will list all VPCs)
  -- Fields: dryRun, filters, maxResults, nextToken, vpcIds
  request = aws.ec2.DescribeVpcsRequest.DescribeVpcsRequest None None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = !(aws.ec2.describeVpcs request)
  
  printLine "  ✓ SUCCESS: DescribeVpcs returned"
  
  -- Extract and display VPCs
  vpcsOpt = aws.ec2.DescribeVpcsResult.vpcs response
  vpcs = Optional.getOrElse [] vpcsOpt
  
  if List.isEmpty vpcs then
    printLine "  → No VPCs found"
  else
    printLine ("  → Found " ++ Nat.toText (List.size vpcs) ++ " VPC(s):")
    printVpcInfo vpc =
      vpcId = Optional.getOrElse "unknown" (aws.ec2.Vpc.vpcId vpc)
      cidr = Optional.getOrElse "unknown" (aws.ec2.Vpc.cidrBlock vpc)
      isDefault = Optional.getOrElse false (aws.ec2.Vpc.isDefault vpc)
      !(requireParsed "vpcId" vpcId)
      !(requireParsed "cidrBlock" cidr)
      printLine ("    - VPC ID: " ++ vpcId)
      printLine ("      CIDR: " ++ cidr)
      printLine ("      Default: " ++ Boolean.toText isDefault)
    List.foreach printVpcInfo vpcs

{{
Describe Subnets created by Terraform.
}}
describeSubnetsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
describeSubnetsDemo = do
  printLine "  → Calling DescribeSubnets..."
  
  -- Create request with empty options (will list all subnets)
  -- Fields: dryRun, filters, maxResults, nextToken, subnetIds
  request = aws.ec2.DescribeSubnetsRequest.DescribeSubnetsRequest None None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = !(aws.ec2.describeSubnets request)
  
  printLine "  ✓ SUCCESS: DescribeSubnets returned"
  
  -- Extract and display subnets
  subnetsOpt = aws.ec2.DescribeSubnetsResult.subnets response
  subnets = Optional.getOrElse [] subnetsOpt
  
  if List.isEmpty subnets then
    printLine "  → No subnets found"
  else
    printLine ("  → Found " ++ Nat.toText (List.size subnets) ++ " subnet(s):")
    printSubnetInfo subnet =
      subnetId = Optional.getOrElse "unknown" (aws.ec2.Subnet.subnetId subnet)
      vpcId = Optional.getOrElse "unknown" (aws.ec2.Subnet.vpcId subnet)
      cidr = Optional.getOrElse "unknown" (aws.ec2.Subnet.cidrBlock subnet)
      az = Optional.getOrElse "unknown" (aws.ec2.Subnet.availabilityZone subnet)
      !(requireParsed "subnetId" subnetId)
      !(requireParsed "vpcId" vpcId)
      !(requireParsed "cidrBlock" cidr)
      !(requireParsed "availabilityZone" az)
      printLine ("    - Subnet ID: " ++ subnetId)
      printLine ("      VPC ID: " ++ vpcId)
      printLine ("      CIDR: " ++ cidr)
      printLine ("      AZ: " ++ az)
    List.foreach printSubnetInfo subnets

{{
Describe Security Groups created by Terraform.
}}
describeSecurityGroupsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
describeSecurityGroupsDemo = do
  printLine "  → Calling DescribeSecurityGroups..."
  
  -- Create request with empty options (will list all security groups)
  -- Fields: dryRun, filters, groupIds, groupNames, maxResults, nextToken
  request = aws.ec2.DescribeSecurityGroupsRequest.DescribeSecurityGroupsRequest None None None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = !(aws.ec2.describeSecurityGroups request)
  
  printLine "  ✓ SUCCESS: DescribeSecurityGroups returned"
  
  -- Extract and display security groups
  sgsOpt = aws.ec2.DescribeSecurityGroupsResult.securityGroups response
  sgs = Optional.getOrElse [] sgsOpt
  
  if List.isEmpty sgs then
    printLine "  → No security groups found"
  else
    printLine ("  → Found " ++ Nat.toText (List.size sgs) ++ " security group(s):")
    printSgInfo sg =
      groupId = Optional.getOrElse "unknown" (aws.ec2.SecurityGroup.groupId sg)
      groupName = Optional.getOrElse "unknown" (aws.ec2.SecurityGroup.groupName sg)
      description = Optional.getOrElse "unknown" (aws.ec2.SecurityGroup.description sg)
      vpcId = Optional.getOrElse "unknown" (aws.ec2.SecurityGroup.vpcId sg)
      !(requireParsed "groupId" groupId)
      !(requireParsed "groupName" groupName)
      !(requireParsed "description" description)
      !(requireParsed "vpcId" vpcId)
      printLine ("    - Group ID: " ++ groupId)
      printLine ("      Name: " ++ groupName)
      printLine ("      Description: " ++ description)
      printLine ("      VPC ID: " ++ vpcId)
    List.foreach printSgInfo sgs

{{
Run an EC2 instance using the LocalStack backend.
Uses a dummy AMI ID that LocalStack accepts.
}}
runInstancesDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
runInstancesDemo = do
  printLine "  → Calling RunInstances..."
  
  -- Create a minimal RunInstances request
  -- LocalStack accepts dummy AMI IDs like "ami-12345678"
  -- Required fields: minCount, maxCount
  -- RunInstancesRequest fields (in order):
  -- additionalInfo, blockDeviceMappings, capacityReservationSpecification, clientToken,
  -- cpuOptions, creditSpecification, disableApiStop, disableApiTermination, dryRun,
  -- ebsOptimized, elasticGpuSpecification, elasticInferenceAccelerators, enablePrimaryIpv6,
  -- enclaveOptions, hibernationOptions, iamInstanceProfile, imageId,
  -- instanceInitiatedShutdownBehavior, instanceMarketOptions, instanceType,
  -- ipv6AddressCount, ipv6Addresses, kernelId, keyName, launchTemplate,
  -- licenseSpecifications, maintenanceOptions, maxCount, metadataOptions, minCount,
  -- monitoring, networkInterfaces, networkPerformanceOptions, operator, placement,
  -- privateDnsNameOptions, privateIpAddress, ramdiskId, secondaryInterfaces, securityGroupIds,
  -- securityGroups, subnetId, tagSpecifications, userData
  request = aws.ec2.RunInstancesRequest.RunInstancesRequest None None None None None None None None None None None None None None None None (Some "ami-12345678") None None (Some aws.ec2.InstanceType't2_micro) None None None None None None None +1 None +1 None None None None None None None None None None None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = !(aws.ec2.runInstances request)
  
  printLine "  ✓ SUCCESS: RunInstances returned"
      
  -- Extract and display reservation info
  reservationId = Optional.getOrElse "unknown" (aws.ec2.Reservation.reservationId response)
  !(requireParsed "reservationId" reservationId)
  printLine ("  → Reservation ID: " ++ reservationId)
          
  -- Display instances from the reservation
  instancesOpt = aws.ec2.Reservation.instances response
  instances = Optional.getOrElse [] instancesOpt
      
  if List.isEmpty instances then
    printLine "  → No instances in reservation"
  else
    printLine ("  → Launched " ++ Nat.toText (List.size instances) ++ " instance(s):")
    printInstanceInfo instance =
      instanceId = Optional.getOrElse "unknown" (aws.ec2.Instance.instanceId instance)
      instanceType = Optional.getOrElse "unknown" (Optional.map aws.ec2.instanceTypeToText (aws.ec2.Instance.instanceType instance))
      privateIp = Optional.getOrElse "none" (aws.ec2.Instance.privateIpAddress instance)
      
      -- Get instance state
      stateOpt = aws.ec2.Instance.state instance
      stateName = match stateOpt with
        None -> "unknown"
        Some s -> Optional.getOrElse "unknown" (Optional.map aws.ec2.instanceStateNameToText (aws.ec2.InstanceState.name s))
      
      !(requireParsed "instanceId" instanceId)
      !(requireParsed "instanceType" instanceType)
      !(requireParsed "stateName" stateName)
      printLine ("    - Instance ID: " ++ instanceId)
      printLine ("      Instance Type: " ++ instanceType)
      printLine ("      State: " ++ stateName)
      printLine ("      Private IP: " ++ privateIp)
    List.foreach printInstanceInfo instances

{{
Describe EC2 instances (if any are running).
}}
describeInstancesDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
describeInstancesDemo = do
  printLine "  → Calling DescribeInstances..."
  
  -- Create request with empty options (will list all instances)
  -- Fields: dryRun, filters, instanceIds, maxResults, nextToken
  request = aws.ec2.DescribeInstancesRequest.DescribeInstancesRequest None None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = !(aws.ec2.describeInstances request)
  
  printLine "  ✓ SUCCESS: DescribeInstances returned"
  
  -- Extract and display instances
  reservationsOpt = aws.ec2.DescribeInstancesResult.reservations response
  reservations = Optional.getOrElse [] reservationsOpt
  
  if List.isEmpty reservations then
    printLine "  → No reservations found (no instances running)"
  else
    printLine ("  → Found " ++ Nat.toText (List.size reservations) ++ " reservation(s):")
    printReservationInfo reservation =
      reservationId = Optional.getOrElse "unknown" (aws.ec2.Reservation.reservationId reservation)
      !(requireParsed "reservationId" reservationId)
      printLine ("    - Reservation ID: " ++ reservationId)
      
      instancesOpt = aws.ec2.Reservation.instances reservation
      instances = Optional.getOrElse [] instancesOpt
      
      if List.isEmpty instances then
        printLine "      No instances in this reservation"
      else
        printInstanceInfo instance =
          instanceId = Optional.getOrElse "unknown" (aws.ec2.Instance.instanceId instance)
          instanceType = Optional.getOrElse "unknown" (Optional.map aws.ec2.instanceTypeToText (aws.ec2.Instance.instanceType instance))
          privateIp = Optional.getOrElse "none" (aws.ec2.Instance.privateIpAddress instance)
          
          -- Get instance state
          stateOpt = aws.ec2.Instance.state instance
          stateName = match stateOpt with
            None -> "unknown"
            Some s -> Optional.getOrElse "unknown" (Optional.map aws.ec2.instanceStateNameToText (aws.ec2.InstanceState.name s))
          
          -- Get instance tags
          tagsOpt = aws.ec2.Instance.tags instance
          tags = Optional.getOrElse [] tagsOpt
          
          !(requireParsed "instanceId" instanceId)
          !(requireParsed "instanceType" instanceType)
          !(requireParsed "stateName" stateName)
          printLine ("      - Instance ID: " ++ instanceId)
          printLine ("        Instance Type: " ++ instanceType)
          printLine ("        State: " ++ stateName)
          printLine ("        Private IP: " ++ privateIp)
          
          if not (List.isEmpty tags) then
            printLine "        Tags:"
            printTagInfo tag =
              key = Optional.getOrElse "unknown" (aws.ec2.Tag.key tag)
              value = Optional.getOrElse "unknown" (aws.ec2.Tag.value tag)
              !(requireParsed "tag.key" key)
              printLine ("          " ++ key ++ ": " ++ value)
            List.foreach printTagInfo tags
          else ()
        List.foreach printInstanceInfo instances
    List.foreach printReservationInfo reservations

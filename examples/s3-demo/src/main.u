-- S3 Demo Application
-- Tests the generated S3 client against Moto mock server
--
-- REQUIREMENTS:
-- To run actual HTTP requests (not placeholders), install @unison/http:
--   lib.install @unison/http/releases/8.0.0
-- Then load the bridge module after aws_http.u:
--   load aws_http_bridge.u
--   add

-- =============================================================================
-- Helpers
-- =============================================================================

-- Get environment variable with default value
envOrDefault : Text -> Text -> '{IO, Exception} Text
envOrDefault name default = do
  result = catch do getEnv name
  match result with
    Either.Left _ -> default
    Either.Right value -> if Text.isEmpty value then default else value

-- Fail if a parsed value is "<unnamed>" (indicates parsing failure)
requireParsed : Text -> Text -> '{IO, Exception} ()
requireParsed fieldName value = do
  if Text.eq value "<unnamed>" then
    Exception.raise (Failure (typeLink Text) ("Parsing failed: " ++ fieldName ++ " returned '<unnamed>'") (Any ()))
  else ()

-- =============================================================================
-- Configuration
-- =============================================================================

-- Create AWS credentials for LocalStack
defaultCredentials : '{IO, Exception} aws.config.Credentials
defaultCredentials = do
  key = !(envOrDefault "AWS_ACCESS_KEY_ID" "dummy")
  secret = !(envOrDefault "AWS_SECRET_ACCESS_KEY" "dummy")
  aws.config.Credentials.Credentials key secret None

-- Test bucket name - created by terraform provisioner in docker-compose
testBucket : Text
testBucket = "us-east-1-nonprod-configs"

-- Test object key
testObjectKey : Text
testObjectKey = "configs/unison-test.txt"

-- Test object content
testObjectContent : Text
testObjectContent = "Hello from Unison S3 Client!"

-- =============================================================================
-- Main Demo
-- =============================================================================

-- Entry point for UCM compile - must have '{IO, Exception} signature
-- Uses Threads.run from @systemfw/concurrent to handle the Threads ability
main : '{IO, Exception} ()
main = do
  -- Get AWS configuration from environment
  regionName = !(envOrDefault "AWS_REGION" "us-east-1")
  creds = !defaultCredentials
  endpointEnv = catch do getEnv "AWS_ENDPOINT"
  endpointUrl = match endpointEnv with
    Either.Right e -> if Text.isEmpty e then None else Some e
    _ -> None
  
  -- Threads.run requires Random ability, use Random.run to provide it
  Random.run do
    systemfw_concurrent_7_3_0.Threads.run do
      Http.run do
        handle !runDemo with AWSEnv.handler regionName creds endpointUrl

-- Actual demo implementation with Threads ability
runDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
runDemo = do
  printLine "╔══════════════════════════════════════════╗"
  printLine "║      S3 Client Demo (LocalStack Backend) ║"
  printLine "╚══════════════════════════════════════════╝"
  printLine ""
  
  region = AWSEnv.region
  endpoint = match AWSEnv.endpoint with
    Some e -> e
    None -> "https://s3." ++ region ++ ".amazonaws.com"
  printLine ("Endpoint: " ++ endpoint)
  printLine ("Region: " ++ region)
  printLine ("Bucket: " ++ testBucket)
  printLine ""
  
  -- Demo 1: List Buckets
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 1: List Buckets"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !listBucketsDemo
  
  -- Demo 2: Put Object
  printLine ""
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 2: Put Object"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !putObjectDemo
  
  -- Demo 3: List Objects (should include our new file)
  printLine ""
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 3: List Objects"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !listObjectsV2Demo
  
  -- Demo 4: Get Object
  printLine ""
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 4: Get Object"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !getObjectDemo
  
  -- Demo 5: Delete Object (cleanup)
  printLine ""
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 5: Delete Object (cleanup)"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !deleteObjectDemo
  
  -- Demo 6: Verify Deletion
  printLine ""
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printLine "Step 6: Verify Deletion"
  printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  !verifyDeletionDemo
  
  printLine ""
  printLine "╔══════════════════════════════════════════╗"
  printLine "║         S3 Demo Complete!                ║"
  printLine "╚══════════════════════════════════════════╝"

-- =============================================================================
-- Demo Functions
-- =============================================================================

{{
List all buckets in the account.
The terraform provisioner creates 'us-east-1-nonprod-configs' bucket.
}}
listBucketsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
listBucketsDemo = do
  printLine "  → Creating ListBucketsRequest..."
  
  -- Create request with all optional fields as None
  request = aws.s3.ListBucketsRequest.ListBucketsRequest None None None None
  
  -- Call the S3 client
  printLine "  → Calling listBuckets..."
  result = !(aws.s3.listBuckets request)
  
  -- Extract and print buckets
  printLine "  ✓ SUCCESS: ListBuckets returned"
  match aws.s3.ListBucketsOutput.buckets result with
    Some buckets -> 
      count = List.size buckets
      printLine ("  → Found " ++ Nat.toText count ++ " bucket(s):")
      printBucketInfo bucket =
        bucketName = Optional.getOrElse "<unnamed>" (Bucket.name bucket)
        !(requireParsed "bucket.name" bucketName)
        printLine ("      • " ++ bucketName)
      List.foreach printBucketInfo buckets
    None -> 
      printLine "  → No buckets found (response was empty)"

{{
Upload a test object to the configs bucket.
}}
putObjectDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
putObjectDemo = do
  printLine ("  → Creating PutObjectRequest...")
  printLine ("    Bucket: " ++ testBucket)
  printLine ("    Key: " ++ testObjectKey)
  printLine ("    Content: \"" ++ testObjectContent ++ "\"")
  
  body = Text.toUtf8 testObjectContent
  
  -- PutObjectRequest with minimal required fields (41 fields)
  -- Field order: aCL body bucket bucketKeyEnabled cacheControl checksumAlgorithm ...
  -- Set ACL to public-read so we can read the object back
  acl = aws.s3.objectCannedACLFromText "public-read"
  request = PutObjectRequest.PutObjectRequest acl body testBucket None None None None None None None None None None None None None (Some "text/plain") None None None None None None None None testObjectKey None None None None None None None None None None None None None None None
  
  -- Call the S3 client
  printLine "  → Calling putObject..."
  result = !(aws.s3.putObject request)
  
  printLine "  ✓ SUCCESS: PutObject completed"
  -- Print ETag if available
  match aws.s3.PutObjectOutput.eTag result with
    Some etag -> printLine ("    ETag: " ++ etag)
    None -> ()

{{
List objects in the configs prefix.
}}
listObjectsV2Demo : '{IO, AWSEnv, Exception, Http, Threads} ()
listObjectsV2Demo = do
  printLine "  → Creating ListObjectsV2Request..."
  printLine ("    Bucket: " ++ testBucket)
  printLine ("    Prefix: configs/")
  
  -- ListObjectsV2Request (11 fields)
  request = aws.s3.ListObjectsV2Request.ListObjectsV2Request testBucket None None None None None (Some +100) None (Some "configs/") None None
  
  -- Call the S3 client
  printLine "  → Calling listObjectsV2..."
  result = !(aws.s3.listObjectsV2 request)
  
  printLine "  ✓ SUCCESS: ListObjectsV2 returned"
  match aws.s3.ListObjectsV2Output.contents result with
    Some objects ->
      count = List.size objects
      printLine ("  → Found " ++ Nat.toText count ++ " object(s):")
      printObjectInfo obj =
        objectKey = Optional.getOrElse "<unnamed>" (Object.key obj)
        !(requireParsed "object.key" objectKey)
        printLine ("      • " ++ objectKey ++ " (" ++ Int.toText (Optional.getOrElse +0 (Object.size obj)) ++ " bytes)")
      List.foreach printObjectInfo objects
    None -> 
      printLine "  → No objects found"

{{
Get the test object we uploaded.
}}
getObjectDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
getObjectDemo = do
  printLine "  → Creating GetObjectRequest..."
  printLine ("    Bucket: " ++ testBucket)
  printLine ("    Key: " ++ testObjectKey)
  
  -- GetObjectRequest (21 fields)
  request = aws.s3.GetObjectRequest.GetObjectRequest testBucket None None None None None None testObjectKey None None None None None None None None None None None None None
  
  -- Call the S3 client
  printLine "  → Calling getObject..."
  result = !(aws.s3.getObject request)
  
  -- Extract and print body
  body = aws.s3.GetObjectOutput.body result
  bodyText = fromUtf8 body
  
  printLine "  ✓ SUCCESS: GetObject returned"
  printLine ("    Body: \"" ++ bodyText ++ "\"")
  
  -- Verify content matches what we uploaded
  if Text.eq bodyText testObjectContent then
    printLine "    ✓ Content matches uploaded data!"
  else
    printLine ("    ✗ Content does NOT match! Expected: \"" ++ testObjectContent ++ "\"")

{{
Delete the test object (cleanup).
}}
deleteObjectDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
deleteObjectDemo = do
  printLine "  → Creating DeleteObjectRequest..."
  printLine ("    Bucket: " ++ testBucket)
  printLine ("    Key: " ++ testObjectKey)
  
  -- DeleteObjectRequest (10 fields)
  request = aws.s3.DeleteObjectRequest.DeleteObjectRequest testBucket None None None None None testObjectKey None None None
  
  -- Call the S3 client
  printLine "  → Calling deleteObject..."
  result = !(aws.s3.deleteObject request)
  
  printLine "  ✓ SUCCESS: DeleteObject completed"
  -- Print delete marker if versioned
  match aws.s3.DeleteObjectOutput.deleteMarker result with
    Some true -> printLine "    Delete marker created (versioned bucket)"
    _ -> ()

{{
Verify the test object was deleted by listing objects.
}}
verifyDeletionDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
verifyDeletionDemo = do
  printLine "  → Listing objects after deletion..."
  printLine ("    Bucket: " ++ testBucket)
  printLine ("    Prefix: configs/")
  
  -- ListObjectsV2Request (11 fields)
  request = aws.s3.ListObjectsV2Request.ListObjectsV2Request testBucket None None None None None (Some +100) None (Some "configs/") None None
  
  -- Call the S3 client
  result = !(aws.s3.listObjectsV2 request)
  
  printLine "  ✓ SUCCESS: ListObjectsV2 returned"
  match aws.s3.ListObjectsV2Output.contents result with
    Some objects ->
      count = List.size objects
      printLine ("  → Found " ++ Nat.toText count ++ " object(s):")
      List.foreach (obj -> printLine ("      • " ++ Optional.getOrElse "<unnamed>" (Object.key obj))) objects
      -- Check if our test object is still there
      hasTestObject = List.any (obj -> Text.eq (Optional.getOrElse "" (Object.key obj)) testObjectKey) objects
      if hasTestObject then
        printLine ("    ✗ Object " ++ testObjectKey ++ " still exists!")
      else
        printLine ("    ✓ Object " ++ testObjectKey ++ " was successfully deleted!")
    None -> 
      printLine "  → No objects found in prefix"
      printLine "    ✓ Deletion verified (prefix is empty)"

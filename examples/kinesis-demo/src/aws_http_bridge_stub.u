{{
Mock response for GetRecords operation.
Returns one record with the test data "Hello from Unison Kinesis Client!"
}}
mockGetRecordsResponse : '{IO, Exception, Threads} Http.Response
mockGetRecordsResponse = do
  -- Base64 encoded "Hello from Unison Kinesis Client!"
  
  jsonBody = 
    """
    {
      "Records": [
        {
          "SequenceNumber": "49590338271490256608559692538361571095921575989136588898",
          "ApproximateArrivalTimestamp": "2024-01-01T00:00:00.000Z",
          "Data": "SGVsbG8gZnJvbSBVbmlzb24gS2luZXNpcyBDbGllbnQh",
          "PartitionKey": "test-partition-1"
        }
      ],
      "NextShardIterator": "AAAAAAAAAAHSywljv0zEgPX4NyKdZ5wryMzP9yALs8NeKbUjp1IxtZs1Sp+KEd8I6AJ9ZG4lNR1EMi+9Md/nHvtLyxpfhEzYvkTZ4D9DQVz/mBYWRO6OTZRKnW9gd+efGN2aHFdkH1rJl4BL9Wyrk+ghYG22D2T1Da2EyNSH1+LAbK33gQweTJADBdyMwlo5r6PqcP2dzhg=",
      "MillisBehindLatest": 0
    }
    """
  bodyBytes = Text.toUtf8 jsonBody
  Http.Response.Response 200 [("Content-Type", "application/x-amz-json-1.1")] bodyBytes

{{
Mock response for unknown operations.
Returns a generic error response.
}}
mockUnknownOperationResponse : '{IO, Exception, Threads} Http.Response
mockUnknownOperationResponse = do
  jsonBody = 
    """
    {
      "__type": "UnknownOperationException",
      "message": "Unknown operation (mock mode)"
    }
    """
  bodyBytes = Text.toUtf8 jsonBody
  Http.Response.Response 400 [("Content-Type", "application/x-amz-json-1.1")] bodyBytes

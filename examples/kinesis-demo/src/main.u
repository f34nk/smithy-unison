-- Kinesis Demo Application
-- Tests the generated Kinesis client using AWSEnv ability
--
-- REQUIREMENTS:
-- Set environment variables: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
-- Optionally AWS_SESSION_TOKEN for temporary credentials

-- =============================================================================
-- Helpers
-- =============================================================================

-- Get environment variable with a default value
envOrDefault : Text -> Text -> '{IO, Exception} Text
envOrDefault name default = do
  result = catch do getEnv name
  match result with
    Either.Left _ -> default
    Either.Right value -> if Text.isEmpty value then default else value

-- Create basic credentials, using env vars when present, otherwise defaults
defaultCredentials : '{IO, Exception} aws.config.Credentials
defaultCredentials = do
  key = !(envOrDefault "AWS_ACCESS_KEY_ID" "dummy")
  secret = !(envOrDefault "AWS_SECRET_ACCESS_KEY" "dummy")
  aws.config.basicCredentials key secret

-- Fail if a parsed Optional value is None (indicates parsing failure)
requireSome : Text -> Optional a -> '{g} a
requireSome fieldName opt = do
  match opt with
    Some value -> value
    None -> bug ("Parsing failed: " ++ fieldName ++ " returned None")

-- =============================================================================
-- Configuration
-- =============================================================================

-- Test stream name - created by terraform provisioner
testStreamName : Text
testStreamName = "kinesis-demo-stream"

-- Test partition key
testPartitionKey : Text
testPartitionKey = "test-partition-1"

-- Test message data
testMessageData : Text
testMessageData = "Hello from Unison Kinesis Client!"

-- =============================================================================
-- Main Demo
-- =============================================================================

-- Entry point for UCM compile - must have '{IO, Exception} signature
main : '{IO, Exception} ()
main = do
  printLine "╔══════════════════════════════════════════════╗"
  printLine "║  Kinesis Client Demo (AWSEnv Ability)       ║"
  printLine "╚══════════════════════════════════════════════╝"
  printLine ""
  region = !(envOrDefault "AWS_REGION" "us-east-1")
  creds = !defaultCredentials
  endpointEnv = getEnv "AWS_ENDPOINT"
  endpoint = if Text.isEmpty endpointEnv then None else Some endpointEnv
  
  -- Run demo with AWSEnv, Http and Threads abilities using provided defaults
  -- Threads.run requires Random, so wrap with Random.run
  Random.run do
    systemfw_concurrent_7_3_0.Threads.run do
      handle
        Http.run do
          regionVal = AWSEnv.region
          printLine ("Region: " ++ regionVal)
          printLine ("Stream: " ++ testStreamName)
          printLine ""
          
          -- Demo 1: List Streams
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 1: List Streams"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !listStreamsDemo
          
          -- Demo 2: Describe Stream
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 2: Describe Stream"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          shardId = !describeStreamDemo
          
          -- Demo 3: Put Record
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 3: Put Record"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          sequenceNumber = !putRecordDemo
          
          -- Demo 4: Get Shard Iterator
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 4: Get Shard Iterator"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          shardIterator = !(getShardIteratorDemo shardId)
          
          -- Demo 5: Get Records
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 5: Get Records"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !(getRecordsDemo shardIterator)
          
          printLine ""
          printLine "╔══════════════════════════════════════════════╗"
          printLine "║         Kinesis Demo Complete!               ║"
          printLine "╚══════════════════════════════════════════════╝"
      with AWSEnv.handler region creds endpoint

-- =============================================================================
-- Demo Functions
-- =============================================================================

{{
List all Kinesis streams.
Verifies that our test stream exists.
}}
listStreamsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
listStreamsDemo = do
  printLine "  → Creating ListStreamsInput..."
  printLine "    Limit: 10"
  
  -- ListStreamsInput: exclusiveStartStreamName, limit, nextToken
  request = aws.kinesis.ListStreamsInput.ListStreamsInput None (Some +10) None
  
  -- Call the Kinesis client (no config needed - uses AWSEnv)
  printLine "  → Calling listStreams..."
  result = aws.kinesis.listStreams request
  
  printLine "  ✓ SUCCESS: ListStreams returned"
  
  -- Extract and display stream names
  streamNames = aws.kinesis.ListStreamsOutput.streamNames result
  count = List.size streamNames
  printLine ("  → Found " ++ Nat.toText count ++ " stream(s)")
  
  -- Print each stream name
  go i = cases
    [] -> ()
    name +: rest ->
      printLine ("    [" ++ Nat.toText i ++ "] " ++ name)
      if Text.eq name testStreamName then
        printLine "        ✓ Test stream found!"
      else
        ()
      go (i + 1) rest
  
  go 0 streamNames
  
  hasMore = aws.kinesis.ListStreamsOutput.hasMoreStreams result
  if hasMore then
    printLine "  → More streams available (use pagination to see all)"
  else
    ()

{{
Describe the test stream to get shard information.
Returns the first shard ID for use in subsequent operations.
}}
describeStreamDemo : '{IO, AWSEnv, Exception, Http, Threads} Text
describeStreamDemo = do
  printLine "  → Creating DescribeStreamInput..."
  printLine ("    StreamName: " ++ testStreamName)
  
  -- DescribeStreamInput: exclusiveStartShardId, limit, streamARN, streamName
  request = aws.kinesis.DescribeStreamInput.DescribeStreamInput None None None (Some testStreamName)
  
  -- Call the Kinesis client (no config needed - uses AWSEnv)
  printLine "  → Calling describeStream..."
  result = aws.kinesis.describeStream request
  
  printLine "  ✓ SUCCESS: DescribeStream returned"
  
  -- Extract stream description
  streamDesc = aws.kinesis.DescribeStreamOutput.streamDescription result
  streamName = aws.kinesis.StreamDescription.streamName streamDesc
  streamStatus = aws.kinesis.StreamDescription.streamStatus streamDesc
  shards = aws.kinesis.StreamDescription.shards streamDesc
  
  printLine ("  → Stream Name: " ++ streamName)
  printLine ("  → Stream Status: " ++ aws.kinesis.streamStatusToText streamStatus)
  printLine ("  → Number of Shards: " ++ Nat.toText (List.size shards))
  
  -- Get the first shard ID
  match List.at 0 shards with
    Some shard ->
      shardId = aws.kinesis.Shard.shardId shard
      printLine ("  → First Shard ID: " ++ shardId)
      shardId
    None ->
      printLine "  ✗ ERROR: No shards found in stream"
      ""

{{
Put a test record into the stream.
Returns the sequence number of the record.
}}
putRecordDemo : '{IO, AWSEnv, Exception, Http, Threads} Text
putRecordDemo = do
  printLine "  → Creating PutRecordInput..."
  printLine ("    StreamName: " ++ testStreamName)
  printLine ("    PartitionKey: " ++ testPartitionKey)
  printLine ("    Data: \"" ++ testMessageData ++ "\"")
  
  -- Convert the message to Bytes
  dataBytes = Text.toUtf8 testMessageData
  
  -- PutRecordInput: data, explicitHashKey, partitionKey, sequenceNumberForOrdering, streamARN, streamName
  request = aws.kinesis.PutRecordInput.PutRecordInput dataBytes None testPartitionKey None None (Some testStreamName)
  
  -- Call the Kinesis client (no config needed - uses AWSEnv)
  printLine "  → Calling putRecord..."
  result = aws.kinesis.putRecord request
  
  printLine "  ✓ SUCCESS: PutRecord completed"
  
  -- Display result details
  sequenceNumber = aws.kinesis.PutRecordOutput.sequenceNumber result
  shardId = aws.kinesis.PutRecordOutput.shardId result
  
  printLine ("  → Sequence Number: " ++ sequenceNumber)
  printLine ("  → Shard ID: " ++ shardId)
  
  sequenceNumber

{{
Get a shard iterator for reading records from the stream.
Uses TRIM_HORIZON to start from the beginning of the shard.
}}
getShardIteratorDemo : Text -> '{IO, AWSEnv, Exception, Http, Threads} Text
getShardIteratorDemo shardId = do
  printLine "  → Creating GetShardIteratorInput..."
  printLine ("    StreamName: " ++ testStreamName)
  printLine ("    ShardId: " ++ shardId)
  printLine "    ShardIteratorType: TRIM_HORIZON"
  
  -- GetShardIteratorInput: shardId, shardIteratorType, startingSequenceNumber, streamARN, streamName, timestamp
  request = aws.kinesis.GetShardIteratorInput.GetShardIteratorInput shardId aws.kinesis.ShardIteratorType'TRIM_HORIZON None None (Some testStreamName) None
  
  -- Call the Kinesis client (no config needed - uses AWSEnv)
  printLine "  → Calling getShardIterator..."
  result = aws.kinesis.getShardIterator request
  
  printLine "  ✓ SUCCESS: GetShardIterator returned"
  
  -- Extract shard iterator
  iterator = !(requireSome "shardIterator" (aws.kinesis.GetShardIteratorOutput.shardIterator result))
  printLine ("  → Shard Iterator: " ++ Text.take 50 iterator ++ "...")
  iterator

{{
Get records from the stream using the shard iterator.
Reads and verifies the data we put into the stream.
}}
getRecordsDemo : Text -> '{IO, AWSEnv, Exception, Http, Threads} ()
getRecordsDemo shardIterator = do
  printLine "  → Creating GetRecordsInput..."
  printLine "    Limit: 10"
  
  -- GetRecordsInput: limit, shardIterator, streamARN
  request = aws.kinesis.GetRecordsInput.GetRecordsInput (Some +10) shardIterator None
  
  -- Call the Kinesis client (no config needed - uses AWSEnv)
  printLine "  → Calling getRecords..."
  result = aws.kinesis.getRecords request
  
  printLine "  ✓ SUCCESS: GetRecords returned"
  
  -- Extract records
  records = aws.kinesis.GetRecordsOutput.records result
  count = List.size records
  printLine ("  → Received " ++ Nat.toText count ++ " record(s)")
  
  -- Display millis behind latest
  match aws.kinesis.GetRecordsOutput.millisBehindLatest result with
    Some millis ->
      printLine ("  → Millis Behind Latest: " ++ Int.toText millis)
    None -> ()
  
  -- Process each record
  go i = cases
    [] -> ()
    record +: rest ->
      printLine ("")
      printLine ("  Record " ++ Nat.toText i ++ ":")
      
      -- Get sequence number
      seqNum = aws.kinesis.Record.sequenceNumber record
      printLine ("    Sequence Number: " ++ seqNum)
      
      -- Get partition key
      partKey = aws.kinesis.Record.partitionKey record
      printLine ("    Partition Key: " ++ partKey)
      
      -- Get and decode data
      dataBytes = aws.kinesis.Record.data record
      match catch do fromUtf8 dataBytes with
        Right dataText ->
          printLine ("    Data: \"" ++ dataText ++ "\"")
          
          -- Verify content matches what we sent
          if Text.eq dataText testMessageData then
            printLine "    ✓ Content matches sent message!"
          else
            printLine ("    ✗ Content does NOT match! Expected: \"" ++ testMessageData ++ "\"")
        Left _ ->
          printLine "    Data: (could not decode as UTF-8)"
      
      go (i + 1) rest
  
  go 0 records
  
  -- Display next shard iterator info
  match aws.kinesis.GetRecordsOutput.nextShardIterator result with
    Some nextIter ->
      printLine ("")
      printLine ("  → Next Shard Iterator available: " ++ Text.take 50 nextIter ++ "...")
      printLine "    (Use this to continue reading more records)"
    None ->
      printLine ("")
      printLine "  → No more records available in this shard"

-- Lambda Demo Application
-- Tests the generated Lambda client using AWSEnv ability
--
-- REQUIREMENTS:
-- Set environment variables: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
-- Optionally AWS_SESSION_TOKEN for temporary credentials

-- =============================================================================
-- Helpers
-- =============================================================================

-- Get environment variable with a default value
envOrDefault : Text -> Text -> '{IO, Exception} Text
envOrDefault name default = do
  result = catch do getEnv name
  match result with
    Either.Left _ -> default
    Either.Right value -> if Text.isEmpty value then default else value

-- Create basic credentials, using env vars when present, otherwise defaults
defaultCredentials : '{IO, Exception} aws.config.Credentials
defaultCredentials = do
  key = !(envOrDefault "AWS_ACCESS_KEY_ID" "dummy")
  secret = !(envOrDefault "AWS_SECRET_ACCESS_KEY" "dummy")
  aws.config.basicCredentials key secret

-- Fail if a parsed value is "unnamed" or "unknown" (indicates parsing failure)
requireParsed : Text -> Text -> '{g} ()
requireParsed fieldName value = do
  if Text.eq value "unnamed" || Text.eq value "unknown" then
    bug ("Parsing failed: " ++ fieldName ++ " returned '" ++ value ++ "'")
  else ()

-- Fail if a parsed Optional value is None (indicates parsing failure)
requireSome : Text -> Optional a -> '{g} a
requireSome fieldName opt = do
  match opt with
    Some value -> value
    None -> bug ("Parsing failed: " ++ fieldName ++ " returned None")

-- =============================================================================
-- Configuration
-- =============================================================================

-- Test function name - created by terraform provisioner
testFunctionName : Text
testFunctionName = "lambda-demo-function"

-- Test payload for Lambda invocation
testPayload : Text
testPayload = """{"message": "Hello from Unison Lambda Client!"}"""

-- =============================================================================
-- Main Demo
-- =============================================================================

-- Entry point for UCM compile - must have '{IO, Exception} signature
main : '{IO, Exception} ()
main = do
  printLine "╔══════════════════════════════════════════════╗"
  printLine "║   Lambda Client Demo (AWSEnv Ability)       ║"
  printLine "╚══════════════════════════════════════════════╝"
  printLine ""
  region = !(envOrDefault "AWS_REGION" "us-east-1")
  creds = !defaultCredentials
  endpointEnv = getEnv "AWS_ENDPOINT"
  endpoint = if Text.isEmpty endpointEnv then None else Some endpointEnv
  
  -- Run demo with AWSEnv, Http and Threads abilities using provided defaults
  -- Threads.run requires Random, so wrap with Random.run
  Random.run do
    systemfw_concurrent_7_3_0.Threads.run do
      handle
        Http.run do
          regionVal = AWSEnv.region
          printLine ("Region: " ++ regionVal)
          printLine ("Function: " ++ testFunctionName)
          printLine ""
          
          -- Demo 1: List Functions
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 1: List Functions"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !listFunctionsDemo
          
          -- Demo 2: Get Function Configuration
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 2: Get Function Configuration"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !getFunctionDemo
          
          -- Demo 3: Invoke Function
          printLine ""
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          printLine "Step 3: Invoke Function"
          printLine "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          !invokeFunctionDemo
          
          printLine ""
          printLine "╔══════════════════════════════════════════════╗"
          printLine "║          Lambda Demo Complete!               ║"
          printLine "╚══════════════════════════════════════════════╝"
      with AWSEnv.handler region creds endpoint

-- =============================================================================
-- Demo Functions
-- =============================================================================

{{
List all Lambda functions.
Verifies that our test function exists.
}}
listFunctionsDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
listFunctionsDemo = do
  printLine "  → Calling ListFunctions..."
  
  -- Create request with empty options (will list all functions)
  request = aws.lambda.ListFunctionsRequest.ListFunctionsRequest None None None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = aws.lambda.listFunctions request
  
  printLine "  ✓ SUCCESS: ListFunctions returned"
  
  -- Extract and display functions
  functionsOpt = aws.lambda.ListFunctionsResponse.functions response
  functions = Optional.getOrElse [] functionsOpt
  
  if List.isEmpty functions then
    printLine "  → No functions found"
  else
    printLine ("  → Found " ++ Nat.toText (List.size functions) ++ " function(s):")
    printFunctionInfo fn =
      name = Optional.getOrElse "unnamed" (aws.lambda.FunctionConfiguration.functionName fn)
      runtime = Optional.getOrElse "unknown" (Optional.map aws.lambda.runtimeToText (aws.lambda.FunctionConfiguration.runtime fn))
      handler = Optional.getOrElse "unknown" (aws.lambda.FunctionConfiguration.handler fn)
      !(requireParsed "functionName" name)
      !(requireParsed "runtime" runtime)
      !(requireParsed "handler" handler)
      printLine ("    - " ++ name)
      printLine ("      Runtime: " ++ runtime)
      printLine ("      Handler: " ++ handler)
    List.foreach printFunctionInfo functions

{{
Get configuration details for the test function.
}}
getFunctionDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
getFunctionDemo = do
  printLine "  → Calling GetFunction..."
  printLine ("    FunctionName: " ++ testFunctionName)
  
  -- Create request with function name
  request = aws.lambda.GetFunctionRequest.GetFunctionRequest testFunctionName None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = aws.lambda.getFunction request
  
  printLine "  ✓ SUCCESS: GetFunction returned"
  
  -- Extract and display function details
  fnConfig = !(requireSome "configuration" (aws.lambda.GetFunctionResponse.configuration response))
  
  name = Optional.getOrElse "unnamed" (aws.lambda.FunctionConfiguration.functionName fnConfig)
  runtime = Optional.getOrElse "unknown" (Optional.map aws.lambda.runtimeToText (aws.lambda.FunctionConfiguration.runtime fnConfig))
  handler = Optional.getOrElse "unknown" (aws.lambda.FunctionConfiguration.handler fnConfig)
  memSize = Optional.getOrElse +0 (aws.lambda.FunctionConfiguration.memorySize fnConfig)
  timeout = Optional.getOrElse +0 (aws.lambda.FunctionConfiguration.timeout fnConfig)
  state = Optional.getOrElse "unknown" (Optional.map aws.lambda.stateToText (aws.lambda.FunctionConfiguration.state fnConfig))
  
  !(requireParsed "functionName" name)
  !(requireParsed "runtime" runtime)
  !(requireParsed "handler" handler)
  !(requireParsed "state" state)
  
  printLine ("  → Function Name: " ++ name)
  printLine ("  → Runtime: " ++ runtime)
  printLine ("  → Handler: " ++ handler)
  printLine ("  → Memory Size: " ++ Int.toText memSize ++ " MB")
  printLine ("  → Timeout: " ++ Int.toText timeout ++ " seconds")
  printLine ("  → State: " ++ state)

{{
Invoke the Lambda function with test payload.
}}
invokeFunctionDemo : '{IO, AWSEnv, Exception, Http, Threads} ()
invokeFunctionDemo = do
  printLine "  → Calling Invoke..."
  printLine ("    FunctionName: " ++ testFunctionName)
  printLine ("    Payload: " ++ testPayload)
  
  -- Create request with function name and payload
  -- InvocationRequest fields (alphabetically): clientContext durableExecutionName functionName invocationType logType payload qualifier tenantId
  payloadBytes = Text.toUtf8 testPayload
  request = aws.lambda.InvocationRequest.InvocationRequest None None testFunctionName None None (Some payloadBytes) None None
  
  -- Call the API (no config needed - uses AWSEnv)
  response = aws.lambda.invoke request
  
  -- Extract response details
  statusCode = aws.lambda.InvocationResponse.statusCode response
  payloadResponseOpt = aws.lambda.InvocationResponse.payload response
  
  printLine "  ✓ SUCCESS: Invoke completed"
  printLine ("  → Status Code: " ++ Int.toText statusCode)
  printLine "  → Response Payload:"
  
  -- Try to decode the response payload
  match payloadResponseOpt with
    None -> printLine "    (no payload)"
    Some payloadResponse ->
      responseText = catch do fromUtf8 payloadResponse
      match responseText with
        Either.Right text -> printLine ("    " ++ text)
        Either.Left _ -> printLine "    (binary response)"
  
  printLine "  ✓ Function executed successfully!"
